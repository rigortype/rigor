# The plugin contract every Rigor plugin subclasses. The signatures
# below are the RBS face of `lib/rigor/plugin/base.rb`; they let the
# `lib` Steep target check Base's own implementation against the
# declared surface and give plugin subclasses (once they enter a check
# target) method resolution for the DSL + hook surface.
#
# ADR-128 WD2 — every hook position takes a plugin-facing interface
# (`sig/rigor/plugin/interfaces.rbs`), a concrete Prism node class, a
# `Rigor::Type::t` or a core type, instead of `untyped`. A hook's `scope`
# is non-nil where every engine call site passes one: the per-file hooks
# receive the seeded `Scope.empty(...)`, `MethodDispatcher#try_plugin_contribution`
# returns before consulting a plugin when its scope is nil, and
# `StatementEvaluator#apply_plugin_assertions` has already read its own. The
# existing `scope.nil?` guards in plugin source stay valid either way.
#
# Collaborators that have no RBS yet (Cache::Descriptor, FlowContribution)
# stay `untyped`; the precision ceiling is the sparse `sig/` tree.
class Rigor::Plugin::Base
  # --- class-level declaration DSLs ---------------------------------

  # Dual-purpose: `manifest(id:, version:, ...)` declares + caches,
  # the no-arg `manifest` reads the cached value back.
  def self.manifest: (**untyped fields) -> Rigor::Plugin::Manifest

  def self.producer: (untyped id, ?watch: untyped, ?serialize: untyped, ?deserialize: untyped, ?generation_cap: untyped) { (untyped params) -> untyped } -> Symbol
  def self.producers: () -> Hash[Symbol, untyped]

  # The block runs `instance_exec`'d on the plugin: `file_context` is whatever the `node_file_context` block
  # returned (plugin-defined), and a rule may answer one diagnostic, an array of them, or nil.
  def self.node_rule: (singleton(::Prism::Node) node_type) { (::Prism::Node node, Rigor::Plugin::_Scope scope, String path, untyped file_context, Rigor::Plugin::NodeContext context) -> (Rigor::Analysis::Diagnostic | Array[Rigor::Analysis::Diagnostic] | nil) } -> singleton(::Prism::Node)
  def self.node_rules: () -> Array[untyped]

  def self.node_file_context: () { (::Prism::ProgramNode root, Rigor::Plugin::_Scope scope) -> untyped } -> void
  def self.node_file_context_block: () -> (^(::Prism::ProgramNode root, Rigor::Plugin::_Scope scope) -> untyped)?

  def self.dynamic_return: (?receivers: (Array[String] | ^() -> Array[String])?, ?methods: (Array[untyped] | ^() -> Array[untyped])?, ?file_methods: (^(String path) -> Array[untyped])?) { (::Prism::CallNode call_node, Rigor::Plugin::_Scope scope) -> Rigor::Type::t? } -> nil
  def self.dynamic_returns: () -> Array[untyped]

  # The block answers the facts that hold after the call returns normally, or nil. The element is a
  # `Rigor::FlowContribution::Fact`, which has no RBS declaration yet, so it stays `untyped`.
  def self.narrowing_facts: (methods: Array[untyped]) { (::Prism::CallNode call_node, Rigor::Plugin::_Scope scope) -> Array[untyped]? } -> nil
  # The engine-facing reader for the declared `narrowing_facts` rules. Named
  # `type_specifiers` before ADR-80; that spelling was removed in 0.3.0.
  def self.narrowing_facts_rules: () -> Array[untyped]

  def self.suggest: (untyped name, untyped candidates) -> String?

  # --- instance surface --------------------------------------------

  attr_reader services: Rigor::Plugin::_Services
  # Schema-driven per plugin, so the values stay `untyped` (ADR-128 WD2).
  attr_reader config: Hash[String, untyped]

  def initialize: (services: Rigor::Plugin::_Services, ?config: Hash[String, untyped]) -> void

  # Overridable lifecycle / extension hooks (default no-ops).
  def init: (Rigor::Plugin::_Services services) -> nil
  def prepare: (Rigor::Plugin::_Services services) -> nil
  def diagnostics_for_file: (path: String, scope: Rigor::Plugin::_Scope, root: ::Prism::ProgramNode) -> Array[Rigor::Analysis::Diagnostic]
  # authored: hook-contract widening — the element type comes from a plugin gem sig-gen never
  # sees, so no engine work would let it answer; the declared `Array[Rigor::Plugin::TemplateUnit]`
  # over a bare-`[]` default body is the author's contract.
  def template_units_for_file: (path: untyped, source: untyped) -> Array[untyped]
  # authored: hook-contract widening — the element type comes from a plugin gem sig-gen never
  # sees, so no engine work would let it answer; the declared record contract over a bare-`[]`
  # default body is the author's.
  def declared_members: (untyped class_name) -> Array[untyped]

  # Engine-executed dispatch over the declared DSLs.
  def node_rule_diagnostics: (path: String, scope: Rigor::Plugin::_Scope, root: ::Prism::ProgramNode) -> Array[untyped]
  # sig-gen gap: #1007 — the true `return result if result` branch (base.rb:594) flows through an
  # `instance_exec`'d, plugin-supplied Proc that sig-gen's inference does not fold into the return
  # join, so it proposes the literal fallback `nil` instead of the honest contract.
  # `call_node` is a `CallNode` except on the `&:symbol` block path, which dispatches with the
  # `Prism::BlockArgumentNode` itself (`ExpressionTyper#symbol_block_return_type`); a plugin's block is typed for
  # the `CallNode` and a rule that reads it off a `BlockArgumentNode` raises into the rescue below (nil).
  def dynamic_return_type: (call_node: ::Prism::CallNode | ::Prism::BlockArgumentNode, scope: Rigor::Plugin::_Scope, receiver_type: Rigor::Type::t) -> Rigor::Type::t?
  def narrowing_facts_for: (call_node: ::Prism::CallNode, scope: Rigor::Plugin::_Scope) -> Array[untyped]

  # Authoring helpers.
  def diagnostic: (untyped node, path: untyped, message: untyped, ?severity: untyped, ?rule: untyped, ?location: untyped) -> Rigor::Analysis::Diagnostic
  def diagnostics_for: (untyped violations, path: untyped, ?node: untyped) -> Array[untyped]
  def read_fact: (plugin_id: untyped, name: untyped) -> untyped
  def producer_value: (untyped id, ?params: untyped) -> untyped
  def producer_error: (untyped id) -> untyped
  def disclose_once: (untyped key, message: untyped, ?severity: untyped, ?rule: untyped) -> nil
  def emit_once: (untyped key, untyped diagnostics) -> nil
  def run_disclosure_records: () -> Array[untyped]
  def manifest: () -> Rigor::Plugin::Manifest
  def signature_paths: () -> Array[String]
  # Defaults to `manifest.protocol_contracts`; a plugin MAY override to fold per-project config in,
  # but the contract (an Array of ProtocolContract) holds either way.
  def protocol_contracts: () -> Array[Rigor::Plugin::ProtocolContract]
  # The ADR-103 effect surfaces delegate to the manifest by default; a plugin MAY override
  # `effect_attributions` to fold per-project config in, but the contract holds either way.
  def effect_labels: () -> Array[String]
  def effect_attributions: () -> Array[Rigor::Plugin::EffectAttribution]
  def effect_edges: () -> Array[Rigor::Plugin::EffectEdge]
  def effect_entry_points: () -> Array[Rigor::Plugin::EffectEntryPoints]
  def effect_ancestry: () -> Array[Rigor::Plugin::EffectAncestry]
  def io_boundary: () -> Rigor::Plugin::IoBoundary
  def cache_for: (untyped producer_id, ?params: untyped, ?descriptor: untyped) -> Proc
  # authored: returns Rigor::Cache::Descriptor::PluginEntry, which has no RBS declaration yet (#2404); stays `untyped` until it is declared
  def plugin_entry: () -> untyped
end
