# The marker methods live here rather than in `demo.rb` so that a wrong
# constant resolution surfaces as `call.undefined-method` — the diagnostic
# https://github.com/rigortype/rigor/issues/652 actually reports. The rule
# declines on a receiver whose class RBS does not know, so every class that
# appears as a narrowed receiver has to be declared.

class Post
  def top_post: () -> String
end

module Admin
  class Post
    def admin_post: () -> String
  end
end

module Wrap
  class Marker
    def wrap_marker: () -> String
  end

  module Deep
    class Marker
      def deep_marker: () -> String
    end
  end
end

class Loner
  def loner: () -> String
end
