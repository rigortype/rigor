# Rigor core overlay — supplemental core signatures.
#
# --- Resolv#initialize ---
#
# `rbs` before 4.1 declares `Resolv#initialize` as only:
#
#   def initialize: (?Resolv::Hosts | Resolv::DNS resolvers) -> untyped
#
# But `Resolv.new` takes an *array* of resolvers — the runtime default is
# `[Hosts.new, DNS.new]`, and `each_address` iterates the argument — so the
# documented, idiomatic call passes an Array:
#
#   Resolv.new([Resolv::Hosts.new, Resolv::DNS.new(nameserver: ...)])
#
# Against the pre-4.1 signature every overload rejects that Array and
# `call.argument-type-mismatch` false-fires (measured on Mastodon's
# `app/lib/request.rb`).
#
# `rbs` 4.1.0 fixed the signature upstream (ruby/rbs#2960); the overlay
# backports that overload for the older releases the gemspec still supports
# (`>= 3.0, < 5.0`). On 4.1 the appended overload duplicates the upstream
# one, which costs nothing. Drop this file when the rbs floor reaches 4.1.
#
# Loaded ONLY when the `resolv` library resolves
# (`RbsLoader::LIBRARY_SUPPLEMENT_CORE_OVERLAYS`): the `| ...` overload
# continuation is invalid without the base declaration, and the resulting
# `InvalidOverloadMethodError` would take the whole class down.
class Resolv
  def initialize: (?(Array[Resolv::Hosts | Resolv::DNS] | Hash[Symbol, untyped])? resolvers, ?use_ipv6: bool?) -> untyped
                | ...
end

# --- Resolv::DNS#getresources / #getresource / #each_resource ---
#
# `rbs` declares the three typeclass lookups as answering the base class
# whatever the typeclass argument names:
#
#   def getresources: (dns_name name, singleton(Resolv::DNS::Query) typeclass) -> Array[Resolv::DNS::Resource]
#
# so `dns.getresources(d, Resolv::DNS::Resource::IN::MX).map(&:exchange)`
# false-fires `call.undefined-method` (`exchange` is declared on
# `Resolv::DNS::Resource::MX`, not on `Resource`). At runtime every returned
# record is an instance of the typeclass (rigortype/rigor#2828).
#
# The overlay prepends a generic overload binding `T` from `singleton(T)`, so
# the answer is `Array[Resolv::DNS::Resource::IN::MX]`. An argument the
# binder cannot read as a class object under the `Resource` bound leaves `T`
# unbound, and the base overload (`| ...`) still accepts every `Query`
# typeclass the upstream signature does.
class Resolv
  class DNS
    def each_resource: [T < Resolv::DNS::Resource] (Resolv::DNS::dns_name name, singleton(T) typeclass) { (T) -> void } -> void
                     | ...

    def getresource: [T < Resolv::DNS::Resource] (Resolv::DNS::dns_name name, singleton(T) typeclass) -> T
                   | ...

    def getresources: [T < Resolv::DNS::Resource] (Resolv::DNS::dns_name name, singleton(T) typeclass) -> Array[T]
                    | ...
  end
end
