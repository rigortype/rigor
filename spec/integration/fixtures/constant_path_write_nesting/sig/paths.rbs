# The marker methods live here rather than in `demo.rb` so a wrong constant resolution
# surfaces as `call.undefined-method` — `CheckRules`' `rbs_class_known?` gate declines on
# a receiver whose class RBS does not know, so a flat fixture could not fire the
# diagnostic https://github.com/rigortype/rigor/issues/690 actually reports.

class Post
  def top_post: () -> String
end

class Registry
end

