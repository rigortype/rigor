{
  "name": "rigor",
  "displayName": "Rigor — Ruby type checker",
  "description": "Type-aware diagnostics, hover, completion, and outline for Ruby, powered by the Rigor analyzer.",
  "version": "0.1.0",
  "publisher": "rigortype",
  "license": "MPL-2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "ruby",
    "rbs",
    "type checking",
    "static analysis",
    "lsp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rigortype/rigor.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/rigortype/rigor/issues"
  },
  "homepage": "https://github.com/rigortype/rigor/tree/master/editors/vscode",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:ruby",
    "workspaceContains:**/.rigor.yml",
    "workspaceContains:**/.rigor.dist.yml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Rigor spawns the `rigor` executable (often via `bundle exec`) from the workspace. The language server is only started, and the managed Rigor only installed, in trusted workspaces."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Rigor",
      "properties": {
        "rigor.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable the Rigor language server for this workspace folder."
        },
        "rigor.rootDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Relative subdirectory of the workspace folder that holds the Rigor project, for example `api` when `.rigor.yml` lives in `api/`. The server runs there, and Ruby files outside it get no Rigor features. An absolute path is rejected. Write it without surrounding spaces: the `rigor: check` task reads the raw value. Leave empty to use the workspace folder itself."
        },
        "rigor.server.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Explicit path to the `rigor` executable. Overrides Bundler and `PATH` discovery. Leave empty to auto-detect."
        },
        "rigor.server.useBundler": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Use `bundle exec rigor` when a Gemfile.lock pinning `rigortype` is found.",
            "Always use `bundle exec rigor`.",
            "Never use Bundler; run `rigor` from PATH."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "How to resolve the rigor executable relative to Bundler."
        },
        "rigor.server.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a Rigor config file, passed as `--config=PATH`. Leave empty to let the server discover `.rigor.yml` / `.rigor.dist.yml`."
        },
        "rigor.server.logPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to write the server log, passed as `--log=PATH`. Leave empty to send server logs to the output channel."
        },
        "rigor.runtime.version": {
          "type": "string",
          "default": "latest",
          "scope": "application",
          "markdownDescription": "The `rigortype` version of the Rigor the extension installs for itself (**Rigor: Install Managed Rigor**), used only when no other `rigor` is found. `latest` resolves the newest release on rubygems.org; a version such as `0.4.7` pins it."
        },
        "rigor.runtime.rubyPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the Ruby 4.0 executable the managed Rigor is installed with. Leave empty to look for one on `PATH` and in mise, rbenv, chruby and asdf install directories."
        },
        "rigor.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace the JSON-RPC traffic between VSCode and the Rigor language server."
        }
      }
    },
    "commands": [
      {
        "command": "rigor.restartServer",
        "title": "Restart Server",
        "category": "Rigor"
      },
      {
        "command": "rigor.showOutputChannel",
        "title": "Show Output Channel",
        "category": "Rigor"
      },
      {
        "command": "rigor.showServerVersion",
        "title": "Show Server Version",
        "category": "Rigor"
      },
      {
        "command": "rigor.showServerLog",
        "title": "Show Server Log",
        "category": "Rigor"
      },
      {
        "command": "rigor.checkWorkspace",
        "title": "Check Workspace",
        "category": "Rigor"
      },
      {
        "command": "rigor.installManagedRuntime",
        "title": "Install Managed Rigor",
        "category": "Rigor"
      },
      {
        "command": "rigor.checkForUpdate",
        "title": "Check for Rigor Update",
        "category": "Rigor"
      },
      {
        "command": "rigor.clearManagedRuntime",
        "title": "Clear Managed Rigor",
        "category": "Rigor"
      },
      {
        "command": "rigor.showTypeAtCursor",
        "title": "Show Type at Cursor",
        "category": "Rigor"
      },
      {
        "command": "rigor.explainRule",
        "title": "Explain Rule",
        "category": "Rigor"
      },
      {
        "command": "rigor.openConfig",
        "title": "Open Config",
        "category": "Rigor"
      },
      {
        "command": "rigor.generateSignatures",
        "title": "Generate Signatures for File",
        "category": "Rigor"
      },
      {
        "command": "rigor.updateBaseline",
        "title": "Update Baseline",
        "category": "Rigor"
      }
    ],
    "taskDefinitions": [
      {
        "type": "rigor",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["check"],
            "description": "The Rigor subcommand the task runs."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "rigor",
        "owner": "rigor",
        "source": "rigor",
        "fileLocation": ["autoDetect", "${workspaceFolder}/${config:rigor.rootDir}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*?)(?: \\[([^\\[\\]\\s]+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rigor.showTypeAtCursor",
          "when": "rigor.managedFolder"
        },
        {
          "command": "rigor.explainRule",
          "when": "rigor.managedFolder"
        },
        {
          "command": "rigor.openConfig",
          "when": "rigor.managedFolder"
        },
        {
          "command": "rigor.generateSignatures",
          "when": "rigor.managedFolder"
        },
        {
          "command": "rigor.updateBaseline",
          "when": "rigor.managedFolder"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js --production",
    "compile:dev": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "vscode:prepublish": "npm run typecheck && npm run compile",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.23.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.5.0"
  }
}
