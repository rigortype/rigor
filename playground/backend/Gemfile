# frozen_string_literal: true

source "https://rubygems.org"

gem "rigortype", path: "../.."

# ADR-29 WD4 amendment (2026-05-25) + ADR-32 WD10 — the
# playground pre-loads `rigor-rbs-inline` so a pasted snippet
# with `# @rbs name: T`-shaped comments is analysed as
# inline-RBS from the first request. The plugin's
# `require_magic_comment: false` config is set in this
# directory's `.rigor.yml`, which the CLI picks up from the
# Puma process's CWD on each `run_cli` call.
gem "rigor-rbs-inline", path: "../../plugins/rigor-rbs-inline"

gem "puma", "~> 6.0"

group :development, :test do
  gem "rack-test", ">= 2.0", "< 3.0"
  gem "rspec", ">= 3.13", "< 4.0"
end
