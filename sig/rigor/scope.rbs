module Rigor
  class Scope
    attr_reader environment: Environment
    attr_reader locals: Hash[Symbol, Type::t]
    attr_reader fact_store: Analysis::FactStore
    attr_reader self_type: Type::t?
    attr_reader ivars: Hash[Symbol, Type::t]
    attr_reader cvars: Hash[Symbol, Type::t]
    attr_reader globals: Hash[Symbol, Type::t]
    attr_reader discovery: DiscoveryIndex
    attr_reader dynamic_origins: Hash[untyped, Symbol]
    attr_reader local_origins: Hash[Symbol, Symbol]
    attr_reader ivar_origins: Hash[Symbol, Symbol]
    attr_reader void_origins: Hash[untyped, Inference::VoidOrigin]
    attr_reader plugin_typed_calls: Hash[untyped, bool]
    attr_reader optimistic_origins: Hash[untyped, Symbol]
    # A marked binding whose miss answer is known stores an `Inference::OptimisticOrigin::BoundMark` (a `Data`)
    # in place of its bare cause (issue #1302).
    attr_reader optimistic_locals: Hash[Symbol, Symbol | Data]
    attr_reader optimistic_ivars: Hash[Symbol, Symbol | Data]
    # sig-gen gap: #1154 — an `attr_reader` over an ivar assigned in `initialize` from a parameter reaches `untyped`.
    attr_reader repeated_or_writes: Hash[untyped, bool]
    # sig-gen gap: #1154 — the same reader shape; `Inference::MatchRebinding::Frame` carries no signature.
    attr_reader match_frame: untyped
    attr_reader indexed_narrowings: Hash[IndexedKey, Type::t]
    attr_reader method_chain_narrowings: Hash[ChainKey, Type::t]
    attr_reader source_path: String?
    attr_reader struct_fold_safe_locals: Set[Symbol]
    attr_reader opaque_block_self: bool
    # sig-gen gap: #1154 — sig-gen skips the reader (sig.skipped.untyped-return): an `attr_reader`
    # over an ivar assigned in `initialize` from a parameter, so inference reaches `untyped`.
    attr_reader singleton_class_body: bool
    attr_reader lexical_nesting: Array[String]?

    # ADR-53 Track A — the seed-time discovery tables live on the
    # DiscoveryIndex; Scope keeps per-table readers as delegates.
    def declared_types: () -> Hash[untyped, Type::t]
    def class_ivars: () -> Hash[String, Hash[Symbol, Type::t]]
    def class_cvars: () -> Hash[String, Hash[Symbol, Type::t]]
    def program_globals: () -> Hash[Symbol, Type::t]
    def discovered_classes: () -> Hash[String, Type::Singleton]
    def in_source_constants: () -> Hash[String, Type::t]
    def discovered_methods: () -> Hash[String, Hash[Symbol, Symbol]]
    def discovered_def_nodes: () -> Hash[String, Hash[Symbol, untyped]]
    def discovered_singleton_def_nodes: () -> Hash[String, Hash[Symbol, untyped]]
    def discovered_def_sources: () -> Hash[String, Hash[Symbol, String]]
    def discovered_singleton_def_sources: () -> Hash[String, Hash[Symbol, String]]
    def discovered_method_visibilities: () -> Hash[String, Hash[Symbol, Symbol]]
    # sig-gen gap: #1148 — sig-gen skips an endless-def reader (untyped return); the row is hand-written.
    def discovered_parameter_envelopes: () -> Hash[String, Hash[untyped, untyped]]
    # sig-gen gap: #1149 — sig-gen skips the `||` fallback reader (untyped return); the row is hand-written.
    def parameter_envelopes_of: (String class_name) -> Hash[untyped, untyped]
    def discovered_superclasses: () -> Hash[String, String]
    # sig-gen gap: #1148 — sig-gen skips the endless-def reader (untyped return), so the per-file
    # deferred-range table's row shape is hand-written.
    def discovered_deferred_ranges: () -> Hash[String, Array[[Integer, Integer, Symbol?, Symbol?, String?]]]
    # sig-gen gap: #1148 — sig-gen skips the endless-def reader (untyped return), so the refinement table's
    # shape is hand-written.
    def discovered_refinements: () -> Hash[String, Hash[Symbol, Array[String]]]
    # sig-gen gap: #1148 — sig-gen skips the endless-def reader (untyped return), so the census shape is
    # hand-written.
    def discovered_global_write_census: () -> Set[Array[untyped]]
    def discovered_includes: () -> Hash[String, Array[String]]
    # Issue #1123 — the instance-ancestor-ORDER table beside the include one.
    def discovered_prepends: () -> Hash[String, Array[String]]
    # sig-gen gap: #1148 — sig-gen skips the endless-def reader (untyped return), so the table shape is hand-written.
    def discovered_extends: () -> Hash[String, Array[String]]
    def discovered_class_sources: () -> Hash[String, Set[String]]
    def constant_sources: () -> Hash[String, Set[String]]
    def published_constant_names: () -> Set[String]
    def local_constant_names: () -> Set[String]
    # sig-gen gap: #1150 — the `Data.define` table it reads carries no type, so sig-gen skips the return; the shape is hand-written.
    def bound_constant_names: (String name) -> Array[String]
    # sig-gen gap: #1150 — the `Data.define` table it reads carries no type, so sig-gen skips the return; the shape is hand-written.
    def shadowing_constant_names: (String name) -> Array[String]
    # sig-gen gap: #1149 — sig-gen types the `||` fallback `untyped`, so the element type is hand-written.
    def published_constant_ivars_for: (String class_name) -> Set[Symbol]
    def published_constant?: (String name) -> bool
    def record_constant_dependency: (String name) -> void
    def record_class_existence: (String class_name) -> void
    def data_member_layouts: () -> Hash[String, Array[Symbol]]
    def struct_member_layouts: () -> Hash[String, { members: Array[Symbol], keyword_init: bool }]
    def param_inferred_types: () -> Hash[[String, Symbol, Symbol], Hash[Symbol, Type::t]]
    def run_generation: () -> Object?
    def record_dynamic_origin: (untyped node, Symbol cause) -> Scope
    def record_optimistic_origin: (untyped node, Symbol cause) -> Scope

    def record_void_origin: (untyped node, Inference::VoidOrigin origin) -> Scope

    def record_plugin_typed_call: (untyped node) -> Scope
    def plugin_typed_call?: (untyped node) -> bool

    def with_repeated_or_writes: (untyped nodes) -> Rigor::Scope
    # sig-gen gap: #1154 — `Hash#key?` over that reader reaches `untyped`, so the `bool` is hand-written.
    def repeated_or_write?: (untyped node) -> bool

    class DiscoveryIndex
      attr_reader declared_types: Hash[untyped, Type::t]
      attr_reader class_ivars: Hash[String, Hash[Symbol, Type::t]]
      attr_reader class_cvars: Hash[String, Hash[Symbol, Type::t]]
      attr_reader program_globals: Hash[Symbol, Type::t]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader program_global_seeds: Hash[Symbol, Type::t]
      attr_reader discovered_classes: Hash[String, Type::Singleton]
      attr_reader in_source_constants: Hash[String, Type::t]
      attr_reader discovered_methods: Hash[String, Hash[Symbol, Symbol]]
      attr_reader discovered_def_nodes: Hash[String, Hash[Symbol, untyped]]
      attr_reader discovered_def_nestings: Hash[untyped, Array[String]]
      attr_reader discovered_singleton_def_nodes: Hash[String, Hash[Symbol, untyped]]
      attr_reader discovered_def_sources: Hash[String, Hash[Symbol, String]]
      attr_reader discovered_singleton_def_sources: Hash[String, Hash[Symbol, String]]
      attr_reader discovered_method_visibilities: Hash[String, Hash[Symbol, Symbol]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader discovered_parameter_envelopes: Hash[String, Hash[untyped, untyped]]
      attr_reader discovered_superclasses: Hash[String, String]
      attr_reader discovered_includes: Hash[String, Array[String]]
      attr_reader discovered_prepends: Hash[String, Array[String]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader discovered_extends: Hash[String, Array[String]]
      attr_reader discovered_class_sources: Hash[String, Set[String]]
      attr_reader constant_sources: Hash[String, Set[String]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader constant_writers: Hash[String, Array[String]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader constant_shadowers: Hash[String, Array[String]]
      attr_reader published_constant_names: Set[String]
      attr_reader local_constant_names: Set[String]
      # sig-gen gap: #1150 — `Data.define` members carry no type, so every row in this class is authored.
      attr_reader published_constant_alias_names: Set[String]
      # sig-gen gap: #1150 — as above.
      attr_reader published_constant_ivars: Hash[String, Set[Symbol]]
      attr_reader data_member_layouts: Hash[String, Array[Symbol]]
      attr_reader struct_member_layouts: Hash[String, { members: Array[Symbol], keyword_init: bool }]
      attr_reader param_inferred_types: Hash[[String, Symbol, Symbol], Hash[Symbol, Type::t]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader discovered_deferred_ranges: Hash[String, Array[[Integer, Integer, Symbol?, Symbol?, String?]]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader discovered_refinements: Hash[String, Hash[Symbol, Array[String]]]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader discovered_global_write_census: Set[Array[untyped]]
      attr_reader run_generation: Object?
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader patched_line_readers: Set[Symbol]
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader clears_last_status: bool
      # sig-gen gap: #1150 — `Data.define` members carry no type, as for every other row in this class.
      attr_reader defines_case_equality: bool

      EMPTY: DiscoveryIndex

      def with: (?declared_types: Hash[untyped, Type::t], ?class_ivars: Hash[String, Hash[Symbol, Type::t]], ?class_cvars: Hash[String, Hash[Symbol, Type::t]], ?program_globals: Hash[Symbol, Type::t], ?program_global_seeds: Hash[Symbol, Type::t], ?discovered_classes: Hash[String, Type::Singleton], ?in_source_constants: Hash[String, Type::t], ?discovered_methods: Hash[String, Hash[Symbol, Symbol]], ?discovered_def_nodes: Hash[String, Hash[Symbol, untyped]], ?discovered_def_nestings: Hash[untyped, Array[String]], ?discovered_singleton_def_nodes: Hash[String, Hash[Symbol, untyped]], ?discovered_def_sources: Hash[String, Hash[Symbol, String]], ?discovered_singleton_def_sources: Hash[String, Hash[Symbol, String]], ?discovered_method_visibilities: Hash[String, Hash[Symbol, Symbol]], ?discovered_parameter_envelopes: Hash[String, Hash[untyped, untyped]], ?discovered_superclasses: Hash[String, String], ?discovered_includes: Hash[String, Array[String]], ?discovered_prepends: Hash[String, Array[String]], ?discovered_extends: Hash[String, Array[String]], ?discovered_class_sources: Hash[String, Set[String]], ?constant_sources: Hash[String, Set[String]], ?constant_writers: Hash[String, Array[String]], ?constant_shadowers: Hash[String, Array[String]], ?published_constant_names: Set[String], ?local_constant_names: Set[String], ?published_constant_alias_names: Set[String], ?published_constant_ivars: Hash[String, Set[Symbol]], ?data_member_layouts: Hash[String, Array[Symbol]], ?struct_member_layouts: Hash[String, { members: Array[Symbol], keyword_init: bool }], ?param_inferred_types: Hash[[String, Symbol, Symbol], Hash[Symbol, Type::t]], ?discovered_deferred_ranges: Hash[String, Array[[Integer, Integer, Symbol?, Symbol?, String?]]], ?discovered_refinements: Hash[String, Hash[Symbol, Array[String]]], ?discovered_global_write_census: Set[Array[untyped]], ?run_generation: Object?, ?patched_line_readers: Set[Symbol], ?clears_last_status: bool, ?defines_case_equality: bool) -> DiscoveryIndex
    end

    class IndexedKey
      attr_reader receiver_kind: Symbol
      attr_reader receiver_name: Symbol
      attr_reader key: untyped
    end

    class ChainKey
      attr_reader receiver_kind: Symbol
      attr_reader receiver_name: Symbol
      attr_reader method_name: Symbol
    end

    def self.empty: (?environment: Environment, ?source_path: String?) -> Scope

    def initialize: (environment: Environment, locals: Hash[Symbol, Type::t], ?fact_store: Analysis::FactStore, ?self_type: Type::t?, ?ivars: Hash[Symbol, Type::t], ?cvars: Hash[Symbol, Type::t], ?globals: Hash[Symbol, Type::t], ?discovery: DiscoveryIndex, ?source_path: String?, ?dynamic_origins: Hash[untyped, Symbol]) -> void
    def with_source_path: (String? path) -> Scope
    def with_struct_fold_safe: (Set[Symbol] locals) -> Scope
    def with_lexical_nesting: (Array[String]? chain) -> Scope
    def struct_fold_safe?: (String | Symbol name) -> bool
    def entering_opaque_block: () -> Scope
    def opaque_block_self?: () -> bool
    def with_singleton_class_body: (bool) -> Scope
    # sig-gen gap: #1148 — sig-gen skips the endless-def reader (sig.skipped.untyped-return); the row is hand-written.
    def singleton_class_body?: () -> bool
    def with_discovery: (DiscoveryIndex index) -> Scope
    def local: (String | Symbol name) -> Type::t?
    def ivar: (String | Symbol name) -> Type::t?
    def cvar: (String | Symbol name) -> Type::t?
    def global: (String | Symbol name) -> Type::t?
    def local_origin: (String | Symbol name) -> Symbol?
    def ivar_origin: (String | Symbol name) -> Symbol?
    def optimistic_local: (String | Symbol name) -> Symbol?
    def optimistic_ivar: (String | Symbol name) -> Symbol?
    def optimistic_local_miss: (String | Symbol name) -> Object?
    def optimistic_ivar_miss: (String | Symbol name) -> Object?
    def with_local: (String | Symbol name, Type::t type) -> Scope
    def with_ivar: (String | Symbol name, Type::t type) -> Scope
    def with_local_origin: (String | Symbol name, Symbol? cause) -> Scope
    def with_optimistic_local: (String | Symbol name, Symbol? cause, ?miss: Object?) -> Scope
    def with_optimistic_ivar: (String | Symbol name, Symbol? cause, ?miss: Object?) -> Scope
    def with_ivar_origin: (String | Symbol name, Symbol? cause) -> Scope
    def with_cvar: (String | Symbol name, Type::t type) -> Scope
    def with_global: (String | Symbol name, Type::t type) -> Scope
    # sig-gen gap: #1151 — an `attr_reader` over a frozen Set literal types `untyped`, as the sibling
    # `declaration_sourced` row does.
    def published_constant_sourced: () -> Set[[Symbol, Symbol]]
    # sig-gen gap: #1152 — `Set#include?` over a tuple key types `untyped`, so the `bool` is hand-written.
    def published_constant_sourced?: (Symbol kind, String | Symbol name) -> bool
    def with_published_constant_mark: (Symbol kind, String | Symbol name) -> Scope
    # Issue #1362 — a `[:global_copy, local, global]` record rides beside the `(kind, name)` refs.
    def declaration_sourced: () -> Set[[Symbol, Symbol] | [Symbol, Symbol, Symbol]]
    def seed_declaration_sourced_ivar: (String | Symbol name, Type::t type) -> Scope
    def seed_declaration_sourced_global: (String | Symbol name, Type::t type) -> Scope
    def with_global_copy_marks: (String | Symbol name, Array[String | Symbol] globals) -> Scope
    def without_local_declaration_marks: (String | Symbol name) -> Scope
    # sig-gen gap: #1154 — the records come out of `@declaration_sourced`, an ivar assigned in `initialize` from a
    # parameter, which reaches `untyped`.
    def declaration_sourced_global_copies: (String | Symbol name) -> Array[Symbol]
    def with_declaration_sourced_local: (String | Symbol name, Type::t type) -> Scope
    def with_local_declaration_mark: (String | Symbol name) -> Scope
    # `rigor sig-gen --params=observed` output; the siblings' hand-written `String | Symbol` / `Type::t`
    # parameters are not inferred here either.
    def with_mutated_local: (untyped name, untyped type) -> Scope
    def declaration_sourced?: (Symbol kind, String | Symbol name) -> bool
    def with_inferred_param_mark: (String | Symbol name) -> Scope
    def without_inferred_param_mark: (String | Symbol name) -> Scope
    def inferred_param?: (String | Symbol name) -> bool
    def forget_match_globals: () -> Scope
    def untyped_match_globals: () -> Scope
    def match_globals_bound?: () -> bool
    def with_match_frame: (untyped body, ?untyped parameters) -> Scope
    # sig-gen gap: #1154 — the frame reader over an ivar assigned in `initialize` from a parameter reaches
    # `untyped`, so the `bool` is hand-written.
    def match_rebinding_closure?: () -> bool
    def forget_last_line: () -> Scope
    def untyped_last_line: () -> Scope
    # sig-gen gap: #1154 — the reader over the `@globals` ivar `initialize` assigns from a parameter reaches
    # `untyped`, so the `bool` is hand-written.
    def last_line_bound?: () -> bool
    # sig-gen gap: #1154 — the frame reader over the `@match_frame` ivar `initialize` assigns from a parameter
    # reaches `untyped`, so the `bool` is hand-written.
    def last_line_closure?: () -> bool
    def forget_error_info: () -> Scope
    def untyped_error_info: () -> Scope
    def forget_last_status: () -> Scope
    def untyped_last_status: () -> Scope
    def class_ivars_for: (String | Symbol? class_name) -> Hash[Symbol, Type::t]
    def class_cvars_for: (String | Symbol? class_name) -> Hash[Symbol, Type::t]
    def discovered_method?: (String | Symbol class_name, String | Symbol method_name, Symbol kind) -> bool
    def user_def_for: (String | Symbol class_name, String | Symbol method_name) -> ::Prism::DefNode?
    def user_def_through_ancestors: (String | Symbol class_name, String | Symbol method_name, ?name_memo: Hash[untyped, untyped]) -> ([::Prism::DefNode, String] | [nil, nil])
    def discovered_method_through_ancestors?: (String | Symbol? class_name, String | Symbol method_name, Symbol kind, ?name_memo: Hash[untyped, untyped]) -> bool
    def external_ancestor_name_candidates: (String | Symbol class_name, ?name_memo: Hash[untyped, untyped]) -> Array[Array[String]]
    def enqueue_ancestors: (String current, Array[String] queue, Hash[untyped, untyped] name_memo, ?mixins: bool) -> void
    def ancestor_name_candidates: (String | Symbol subclass_qualified, String | Symbol raw_ancestor) -> Array[String]

    # sig-gen gap: #1148 — sig-gen skips the method (sig.skipped.untyped-return: every decline returns the
    # frozen EMPTY_HEADER_NESTING constant); the row is hand-written.
    def ambiguous_ancestor_resolutions: (String | Symbol subclass_qualified, String | Symbol raw_ancestor) -> Array[String]

    # Issue #530 — public so the external-gem ancestry probe asks the same question the walk does.
    def known_user_class?: (String | Symbol name) -> bool
    def singleton_def_for: (String | Symbol class_name, String | Symbol method_name) -> ::Prism::DefNode?
    def singleton_def_through_ancestors: (String | Symbol class_name, String | Symbol method_name, ?name_memo: Hash[untyped, untyped]) -> ([::Prism::DefNode, String] | [nil, nil])
    def user_def_site_for: (String | Symbol class_name, String | Symbol method_name) -> String?
    def user_singleton_def_site_for: (String | Symbol class_name, String | Symbol method_name) -> String?
    # sig-gen gap: #1167 — the predicate forwards its untyped `Prism::CallNode` into the range scan,
    # which reads `call_node.location` off it: a `Dynamic` receiver answers `Dynamic`, not `bool`, so
    # sig-gen skips the method (and `def_shadows_call?` above it) as an untyped return.
    def singleton_def_shadows_call?: (String | Symbol class_name, String | Symbol method_name, untyped call_node) -> bool
    # sig-gen gap: #1167 — the instance-side twin: the same untyped `call_node`, the same untyped-return skip.
    def instance_def_shadows_call?: (String | Symbol class_name, String | Symbol method_name, untyped call_node) -> bool
    def top_level_def_for: (String | Symbol method_name) -> ::Prism::DefNode?
    def bindable_top_level_def_for: (String | Symbol method_name) -> ::Prism::DefNode?
    def toplevel?: () -> bool
    def discovered_method_visibility: (String | Symbol class_name, String | Symbol method_name) -> Symbol?
    def superclass_of: (String | Symbol class_name) -> String?
    def data_member_layout: (String | Symbol class_name) -> Array[Symbol]?
    def struct_member_layout: (String | Symbol class_name) -> { members: Array[Symbol], keyword_init: bool }?
    def includes_of: (String | Symbol class_name) -> Array[String]
    # sig-gen gap: #1153 — sig-gen proposes `Array[untyped] | []` off the empty-table early return, so the
    # element type is hand-written, matching {#includes_of}.
    def singleton_extends_of: (String | Symbol class_name) -> Array[String]
    def indexed_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, untyped key) -> Type::t?
    def with_indexed_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, untyped key, Type::t type) -> Scope
    def without_indexed_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, untyped key) -> Scope
    def without_indexed_narrowings_for: (Symbol receiver_kind, String | Symbol receiver_name) -> Scope
    def method_chain_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, String | Symbol method_name) -> Type::t?
    def with_method_chain_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, String | Symbol method_name, Type::t type) -> Scope
    def without_method_chain_narrowing: (Symbol receiver_kind, String | Symbol receiver_name, String | Symbol method_name) -> Scope
    def without_method_chain_narrowings_for: (Symbol receiver_kind, String | Symbol receiver_name) -> Scope
    def with_fact: (Analysis::FactStore::Fact fact) -> Scope
    def with_self_type: (Type::t? type) -> Scope
    def facts_for: (?target: Analysis::FactStore::Target?, ?bucket: Symbol?) -> Array[Analysis::FactStore::Fact]
    def local_facts: (String | Symbol name, ?bucket: Symbol?) -> Array[Analysis::FactStore::Fact]
    def type_of: (untyped node, ?tracer: Inference::FallbackTracer?) -> Type::t
    def evaluate: (untyped node, ?tracer: Inference::FallbackTracer?) -> [Type::t, Scope]
    def user_method_return: (untyped def_node, Type::t receiver, Array[Type::t] arg_types) -> Type::t?
    def join: (Scope other) -> Scope
    def ==: (untyped other) -> bool
    alias eql? ==
    def hash: () -> Integer
  end
end
