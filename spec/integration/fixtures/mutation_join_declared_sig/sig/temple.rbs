class Temple
  # haml's own spelling: a hand-written element type that names only the
  # array's HEAD symbol, over a body that really appends other shapes.
  def compile_html: (untyped node) -> Array[:multi]

  def collect_flags: (Symbol flag) -> Array[Symbol]

  # The declared gradual arm the rederivation must not flatten away.
  def keeps_declared_gradual_arm: (Array[Integer | untyped] a) -> String

  # The unreadable-arg door onto the same hand-written element type.
  def compile_all: (untyped nodes) -> Array[:multi]

  # Issue #586 — the BARE declared gradual element / key / value arms.
  def keeps_declared_untyped_element: (Array[untyped] a) -> String
  def keeps_declared_untyped_element_in_loop: (Array[untyped] a) -> String
  def keeps_declared_untyped_hash_arms: (Hash[untyped, untyped] h) -> String

  # The fresh-seed siblings that must still close (and still fire).
  def closes_a_fresh_seed: (Array[String] xs) -> untyped
  def closes_a_fresh_seed_in_loop: () -> untyped

  # A `non-empty-array[String]` seed after `xs.any?` narrowing.
  def appends_into_non_empty_seed: (Array[String] xs) -> untyped
  def appends_into_non_empty_seed_in_loop: (Array[String] xs) -> untyped

  def genuinely_wrong: () -> Array[Symbol]
end
