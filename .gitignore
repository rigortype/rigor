/.bundle/
/.direnv/
**/.rigor/cache/
# Developer-local Rigor config override. The committed default is
# `.rigor.dist.yml`; auto-discovery prefers `.rigor.yml` when present
# (no implicit merge).
/.rigor.yml
/coverage/
/coverage_report.txt
/pkg/
/tmp/
/vendor/bundle/
/tool/*/vendor/bundle/
/result
/playground/backend/Gemfile.lock
# `make bench` writes the suggested baseline here (ADR-50 WD4); the
# committed, calibrated baseline is bench/baseline.json.
/bench/baseline.updated.json

# Skill-creator eval workspaces (transient; results belong in the session, not the tree)
/*-workspace/
