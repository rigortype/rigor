module Rigor
  module Plugin
    # ADR-37 slice 1d — the lexical context of a node, the fifth argument of a `node_rule` block.
    class NodeContext
      EMPTY: nil

      attr_reader ancestors: Array[::Prism::Node]

      def initialize: (Array[::Prism::Node] ancestors) -> void
      # The three finders return the innermost ancestor of a given kind: a `DefNode`, a `ClassNode` or
      # `ModuleNode`, and a `CallNode` respectively. They are declared `Prism::Node?`: `enclosing_def`'s body infers
      # `Prism::DefNode?` since #2719, but sig-gen does not propose a narrower return over a nil-able union (#2914),
      # and the other two blocks (`||`, `&&`) are not a single class test, so their bodies still infer
      # `Prism::Node?`. A narrower declaration would be an unmarked sig-gen divergence (ADR-107).
      def enclosing_def: () -> ::Prism::Node?
      def enclosing_module: () -> ::Prism::Node?
      def enclosing_block: (Symbol method_name) -> ::Prism::Node?
    end
  end
end
