# The core extensions under `ac-library-rb/core_ext/`. `ac-library-rb/modint` loads the `ModInt` conversions;
# `Integer#divisors` and the `Array` conversions need `ac-library-rb/core_ext/all` (or `integer`).
class Object
  private

  def ModInt: (_ToI val) -> AcLibraryRb::ModInt
end

class Array[unchecked out Elem]
  def to_fenwick_tree: () -> AcLibraryRb::FenwickTree
  alias to_fetree to_fenwick_tree

  # The element type is not carried over: a literal array would pin it to the literals it starts with.
  def to_priority_queue: () -> AcLibraryRb::PriorityQueue[untyped]
  alias to_pq to_priority_queue
end

class Integer
  # `ModInt#coerce` makes an Integer on the left answer a `ModInt`.
  def +: (AcLibraryRb::ModInt) -> AcLibraryRb::ModInt | ...
  def -: (AcLibraryRb::ModInt) -> AcLibraryRb::ModInt | ...
  def *: (AcLibraryRb::ModInt) -> AcLibraryRb::ModInt | ...
  def /: (AcLibraryRb::ModInt) -> AcLibraryRb::ModInt | ...

  def divisors: () -> Array[Integer]

  def each_divisor: () { (Integer) -> void } -> Array[Integer]
                  | () -> Enumerator[Integer, Array[Integer]]

  def to_modint: () -> AcLibraryRb::ModInt
  alias to_m to_modint
end

class String
  def to_modint: () -> AcLibraryRb::ModInt
  alias to_m to_modint
end
