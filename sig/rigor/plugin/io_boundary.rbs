class Rigor::Plugin::IoBoundary
  def initialize: (policy: untyped, plugin_id: untyped, ?http_client: untyped) -> void
  def read_file: (untyped) -> String
  def file?: (untyped) -> bool
  def directory?: (untyped) -> bool
  def list_directory: (untyped) -> Array[String]
  def list_directory_kinds: (untyped) -> Hash[String, untyped]
  # Records a `:names` glob row (membership only); a caller needing a match's content `read_file`s it. A `..`
  # segment, a brace or a backslash in `pattern` raises `AccessDeniedError`.
  def glob: (untyped root, untyped pattern) -> Array[String]
  # sig-gen gap: #1154 — the proposal leaves both string fields untyped. `nearest_root` comes from `@policy`, an
  # ivar assigned from an `initialize` parameter (the #1154 shape); `first_path` comes from `@first_refused_path`,
  # written from `record_refusal(path)`'s parameter outside `initialize`, a case #1154 as titled does not yet cover.
  # The record's fields are the running count and the first refused path, nil when nothing was refused.
  def refusal_summary: () -> { count: Integer, first_path: String?, nearest_root: String? }?
  def open_url: (untyped url) -> String
  # Returns a frozen `Rigor::Cache::Descriptor` (no RBS yet -> untyped).
  def cache_descriptor: () -> untyped
  def replay: (untyped descriptor) -> nil
end
