module Rigor
  VERSION: String

  class Configuration
    DEFAULT_PATH: String
    DEFAULTS: Hash[String, untyped]

    attr_reader target_ruby: String
    attr_reader paths: Array[String]
    attr_reader plugins: Array[String]
    attr_reader cache_path: String
    attr_reader baseline_path: String?

    def self.load: (?String? path) -> Configuration
    def self.discover: () -> String?
    def self.load_with_includes: (String path, ?visited: Set[String]) -> Hash[String, untyped]
    def initialize: (?Hash[String, untyped] data, ?bool effects_key_present) -> void
    def to_h: () -> Hash[String, untyped]
    # ADR-103 WD13 — the `effects:` block, nil when the key was absent. Presence is the opt-in.
    attr_reader effects: Hash[String, untyped]?
    def effects_enabled?: () -> bool
    def with_effects_enabled: () -> Rigor::Configuration
  end

  class CLI
    EXIT_USAGE: Integer

    def self.start: (?Array[String] argv, ?out: untyped, ?err: untyped) -> Integer

    def initialize: (?Array[String] argv, ?out: untyped, ?err: untyped) -> void
    def run: () -> Integer

    class TypeOfCommand
      USAGE: String

      def initialize: (argv: Array[String], out: untyped, err: untyped) -> void
      def run: () -> Integer
    end

    class TypeScanCommand
      USAGE: String

      def initialize: (argv: Array[String], out: untyped, err: untyped) -> void
      def run: () -> Integer
    end
  end

  module Analysis
    class Diagnostic
      attr_reader path: String
      attr_reader line: Integer
      attr_reader column: Integer
      attr_reader message: String
      attr_reader severity: Symbol

      def initialize: (path: String, line: Integer, column: Integer, message: String, ?severity: Symbol) -> void
      def error?: () -> bool
      def to_h: () -> Hash[String, untyped]
      def to_s: () -> String

      # Singleton factories plugins build diagnostics through (the
      # `node` / `location` are Prism values, received as `untyped`).
      def self.from_node: (untyped node, path: String, message: String, ?severity: Symbol, ?rule: String?, ?source_family: String, ?receiver_type: untyped, ?method_name: untyped, ?project_definition_site: untyped) -> Rigor::Analysis::Diagnostic
      def self.from_location: (untyped location, path: String, message: String, ?severity: Symbol, ?rule: String?, ?source_family: String, ?receiver_type: untyped, ?method_name: untyped, ?project_definition_site: untyped) -> Rigor::Analysis::Diagnostic
      # `from_message_loc` / `from_name_loc` forward `**` to `from_location`, so their keyword surface is
      # `from_location`'s; only the positional node differs.
      def self.from_message_loc: (untyped node, path: String, message: String, ?severity: Symbol, ?rule: String?, ?source_family: String, ?receiver_type: untyped, ?method_name: untyped, ?project_definition_site: untyped) -> Rigor::Analysis::Diagnostic
      def self.from_name_loc: (untyped node, path: String, message: String, ?severity: Symbol, ?rule: String?, ?source_family: String, ?receiver_type: untyped, ?method_name: untyped, ?project_definition_site: untyped) -> Rigor::Analysis::Diagnostic
    end

    class Result
      attr_reader diagnostics: Array[Diagnostic]
      attr_reader stats: RunStats?

      def initialize: (?diagnostics: Array[Diagnostic], ?stats: RunStats?) -> void
      def success?: () -> bool
      def error_count: () -> Integer
      def to_h: () -> Hash[String, untyped]
    end

    class RunStats
      attr_reader wall_seconds: Float
      attr_reader peak_rss_bytes: Integer?
      attr_reader target_files: Integer
      attr_reader rbs_classes_total: Integer
      attr_reader rbs_classes_project_sig: Integer
      attr_reader rbs_classes_bundled: Integer
      attr_reader gem_walk_classes: Integer
      attr_reader gem_walk_gems: Integer
      attr_reader rbs_attribution_available: bool

      CACHED_SENTINEL: String

      def self.peak_rss_bytes: () -> Integer?
      def self.partition_classes: (class_decl_paths: Hash[String, String], signature_paths: Array[untyped]) -> [Integer, Integer]
      def self.attribution_available?: (class_decl_paths: Hash[String, String]) -> bool

      def initialize: (
        wall_seconds: Float,
        peak_rss_bytes: Integer?,
        target_files: Integer,
        rbs_classes_total: Integer,
        rbs_classes_project_sig: Integer,
        rbs_classes_bundled: Integer,
        gem_walk_classes: Integer,
        gem_walk_gems: Integer,
        ?rbs_attribution_available: bool
      ) -> void
      def format: (untyped out, ?prefix: String) -> void
      def to_h: () -> Hash[Symbol, untyped]
    end

    class Runner
      RUBY_GLOB: String
      DEFAULT_CACHE_ROOT: String
      # `Rigor::Cache::Store` itself is not yet sig-covered (the
      # cache namespace is in `UNSIGNED_NAMESPACES` per
      # `spec/rigor/public_api_drift_spec.rb`), so reference it as
      # `untyped` until the full Cache::Store sig lands. Steep
      # otherwise raises `RBS::UnknownTypeName` for the named type.
      attr_reader cache_store: untyped
      attr_reader plugin_registry: untyped
      attr_reader buffer: untyped
      attr_reader file_dependencies: Hash[String, untyped]
      attr_reader analyzed_files: Array[String]
      def initialize: (configuration: Configuration, ?explain: bool, ?cache_store: untyped, ?plugin_requirer: untyped, ?workers: Integer, ?collect_stats: bool, ?buffer: untyped, ?prebuilt: untyped, ?environment: untyped, ?record_dependencies: bool, ?analyze_only: untyped) -> void
      def run: (?Array[String] paths) -> Result
      def run_source: (source: String, ?path: String) -> Result
      def analysis_file_set: (?Array[String] paths) -> Array[String]
      def file_dependents: () -> Hash[String, untyped]
      def prepare_project_scan: (?paths: Array[String]) -> untyped
      # ADR-103 — the propagated effect graph and the merged per-file collections behind it. A report
      # surface: never a diagnostic, empty when the configuration carries no `effects:` block. Typed
      # `untyped` for the same reason `cache_store` is — `Rigor::Effects` is not sig-covered yet
      # (`spec/rigor/public_api_drift_spec.rb`), and a named reference would raise `RBS::UnknownTypeName`.
      def effect_table: () -> untyped
      def effect_collection: () -> untyped
      # #381 — `{ "Class#m" => [path] }`, which the snapshot's `reach:` globs match against. Same
      # `untyped` reasoning as its two siblings above.
      def effect_sources: () -> untyped
      # #387 — the loaded plugins' compiled effect contributions, read by `rigor effects` so the snapshot's
      # vocabulary is the one the collection window scanned under. Same `untyped` reasoning again.
      def effect_plugin_facts: () -> untyped
      # The incremental session's read surface (ADR-46 / ADR-67 / ADR-103) — `IncrementalSession`
      # drives a live Runner through these between rechecks. Typed `untyped` like the cache / effects
      # readers above until their namespaces are sig-covered.
      def return_summaries: () -> untyped
      def param_inferred_types: () -> untyped
      def effect_collections_by_path: () -> untyped
      def collect_param_inference_table: (untyped files) -> untyped
      def evaluate_return_types: (untyped paths, untyped specs) -> untyped
    end
  end
end
