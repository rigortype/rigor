#!/usr/bin/env bash
# Create a git worktree whose gem bundle is a copy-on-write clone of the main clone.
#
# `vendor/bundle` (~126M, ~9800 files) is populated with APFS clonefile(2): a few
# seconds, near-zero disk, and the worktree gets an ISOLATED, writable bundle. A
# `bundle install` for a branch's own `Gemfile.lock` then diverges only the blocks
# it changes and never touches the main clone or a sibling worktree — unlike a
# `vendor` symlink, where one worktree's `bundle install` mutates everyone's gems.
# On a non-APFS host `cp` falls back to a reflink (btrfs/xfs) or a plain copy.
#
# Usage:
#   bin/rigor-worktree [--with-references] [--with-tools] <branch> [start-point]
#
#   <branch>            existing branch -> checked out; otherwise created from
#                       <start-point> (default: origin/master).
#   --with-references   also CoW-clone the populated references/ submodule
#                       checkouts (read-only here) so a reference-reading gate
#                       does not silently SKIP in the worktree.
#   --with-tools        also CoW-clone the tool/steep and tool/sorbet bundles.
#
# The worktree is created at $RIGOR_WT_ROOT/<slug> (default: <main>/../rigor-wt/<slug>),
# where <slug> is the branch name with a leading `codex/` stripped and `/` -> `-`.
#
# Exit code: 0 on success, non-zero on failure.

set -euo pipefail

prog=${0##*/}
die() { echo "$prog: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
usage: $prog [--with-references] [--with-tools] <branch> [start-point]

  <branch>           existing branch is checked out; a new one is created from
                     <start-point> (default: origin/master)
  --with-references  also CoW-clone the populated references/ submodule checkouts
  --with-tools       also CoW-clone the tool/steep and tool/sorbet bundles

The worktree lands at \$RIGOR_WT_ROOT/<slug> (default: <main>/../rigor-wt/<slug>).
EOF
  exit "${1:-0}"
}

with_references=0
with_tools=0
args=()
for a in "$@"; do
  case "$a" in
    --with-references) with_references=1 ;;
    --with-tools)      with_tools=1 ;;
    -h|--help)         usage 0 ;;
    -*)               die "unknown option: $a (see --help)" ;;
    *)                args+=("$a") ;;
  esac
done

[ "${#args[@]}" -ge 1 ] || usage 1
branch=${args[0]}
start=${args[1]:-origin/master}

main=$(git rev-parse --path-format=absolute --git-common-dir)
main=${main%/.git}
[ -d "$main" ] || die "cannot locate the main clone (resolved: $main)"
[ -d "$main/vendor/bundle" ] || \
  die "no $main/vendor/bundle — run 'make setup' (or 'bundle install') in the main clone first"

slug=${branch#codex/}
slug=${slug//\//-}
wt_root=${RIGOR_WT_ROOT:-$(dirname "$main")/rigor-wt}
wt=$wt_root/$slug
if [ -e "$wt" ]; then die "$wt already exists"; fi

# Pick a copy-on-write cp. GNU cp gets --reflink=auto (CoW on btrfs/xfs, and on
# APFS since coreutils 9.x; a plain copy elsewhere); BSD/macOS `cp -Rc` uses
# clonefile(2) and silently falls back to copyfile(2) across filesystems;
# anything else does a plain recursive copy.
#
# Probe `cp` itself rather than `uname`: the Nix Flake this repo mandates for
# development puts GNU coreutils ahead of /bin on PATH, so on macOS INSIDE the
# Flake `cp` is GNU and `cp -Rc` fails with `invalid option -- 'c'` — which,
# under `set -e`, aborted the script after `git worktree add` had already
# registered the worktree.
cow_cp() {
  local src=$1 dst=$2
  if cp --version 2>/dev/null | grep -q coreutils; then
    cp -a --reflink=auto "$src" "$dst"
  elif [ "$(uname)" = Darwin ]; then
    cp -Rc "$src" "$dst"
  else
    cp -R "$src" "$dst"
  fi
}

# `cp -R SRC DST` with DST an EXISTING directory copies INTO it, so any copy
# destination must be cleared first or the payload lands one level too deep
# (references/ruby/ruby). Guarded: this can only ever remove a path inside $wt.
rm_wt_path() { # rm_wt_path ABS
  local target=$1
  case "$target" in
    "$wt"/?*) ;;
    *) die "internal error: refusing to remove '$target' (outside $wt)" ;;
  esac
  # `..` as a COMPONENT, not as a substring: `$wt` is normalized below, but a
  # substring test would also reject an ordinary entry named `..foo`, and would
  # NOT have been what made a `RIGOR_WT_ROOT` containing `..` safe.
  case "$target" in
    ../*|*/../*|*/..) die "internal error: refusing to remove '$target' (traverses '..')" ;;
  esac
  rm -rf "$target"
}

# `git rev-parse HEAD` is NOT a verification of a reference clone: the `.git`
# pointer written below sits at the right level and resolves against the shared
# module store even when the CONTENTS landed one directory deeper, which is
# exactly the failure this catches. So compare the copy's top-level entries
# against the source's — a nested copy has a single directory named after the
# submodule where the source has its whole checkout, and
# `references/ruby/object.c` (the file spec/docs/c_effects_raises_gate_spec.rb
# opens) is absent. Comparing entries rather than probing a name out of
# `git ls-tree HEAD` is also what holds for the SPARSE checkouts
# (references/phpstan, references/TypeScript-Website), whose working trees
# deliberately materialize only part of HEAD.
reference_entries() { # reference_entries DIR -> top-level names, `.git` excluded
  local dir=$1 f out=""
  for f in "$dir"/* "$dir"/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    case "${f##*/}" in .git) continue ;; esac
    out+="${f##*/}"$'\n'
  done
  printf '%s' "$out"
}

verify_reference_clone() { # verify_reference_clone SRC DST
  local src=$1 dst=$2 name
  name=$(basename "$dst")
  if [ "$(reference_entries "$src")" != "$(reference_entries "$dst")" ]; then
    echo "  ERROR: references/$name: the copy at $dst does not have the same contents as" >&2
    echo "         $src. A nested or partial copy still answers 'git rev-parse HEAD' and" >&2
    echo "         still lists under 'ls references/', so it looks correct while a" >&2
    echo "         reference-reading gate SKIPs on it." >&2
    return 1
  fi
  if ! git -C "$dst" rev-parse --verify --quiet HEAD >/dev/null; then
    echo "  ERROR: references/$name: git linkage does not resolve" >&2
    return 1
  fi
  return 0
}

clone_into_wt() { # clone_into_wt REL   (REL is relative to the repo root)
  local rel=$1
  if [ ! -e "$main/$rel" ]; then echo "  skip $rel (absent in main clone)"; return 0; fi
  mkdir -p "$wt/$(dirname "$rel")"
  rm_wt_path "$wt/$rel"
  cow_cp "$main/$rel" "$wt/$rel"
  echo "  cloned $rel"
}

if git -C "$main" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
  echo "==> git worktree add $wt $branch"
  git -C "$main" worktree add "$wt" "$branch"
else
  echo "==> git worktree add $wt -b $branch $start"
  git -C "$main" worktree add "$wt" -b "$branch" "$start"
fi

# `RIGOR_WT_ROOT` (and `$main`) may contain `..`; resolve the worktree to a
# physical path now that it exists, so every destination the removal guard sees
# is traversal-free.
wt=$(cd "$wt" && pwd -P)

echo "==> cloning the gem bundle (copy-on-write)"
clone_into_wt vendor/bundle
mkdir -p "$wt/.bundle"
if cp "$main/.bundle/config" "$wt/.bundle/config" 2>/dev/null; then
  echo "  copied .bundle/config"
else
  printf 'BUNDLE_PATH: "vendor/bundle"\n' > "$wt/.bundle/config"
  echo "  wrote a default .bundle/config"
fi

if [ "$with_tools" -eq 1 ]; then
  echo "==> cloning the tool bundles"
  for t in tool/steep tool/sorbet; do
    clone_into_wt "$t/vendor"
    if [ -f "$main/$t/.bundle/config" ]; then
      mkdir -p "$wt/$t/.bundle"
      cp "$main/$t/.bundle/config" "$wt/$t/.bundle/config"
    fi
  done
fi

if [ "$with_references" -eq 1 ]; then
  echo "==> cloning references/ submodule checkouts (read-only)"
  ref_failures=0
  for d in "$main"/references/*/; do
    name=$(basename "$d")
    if [ ! -e "${d}.git" ]; then echo "  skip references/$name (not initialized in main)"; continue; fi
    # `git worktree add` has already created an EMPTY placeholder directory for
    # every registered submodule path. Copying onto it would nest the checkout
    # (references/ruby/ruby), which every cheap look — `ls references/`,
    # `git -C references/ruby rev-parse HEAD` — reports as correct while a
    # reference-reading gate SKIPs. Clear it so the copy lands at the path.
    rm_wt_path "$wt/references/$name"
    cow_cp "${d%/}" "$wt/references/$name"
    # A submodule `.git` file is relative to the main clone; re-point the copy
    # at the shared module store so read-only git commands resolve.
    printf 'gitdir: %s/.git/modules/references/%s\n' "$main" "$name" > "$wt/references/$name/.git"
    if verify_reference_clone "${d%/}" "$wt/references/$name"; then
      echo "  cloned references/$name"
    else
      ref_failures=$((ref_failures + 1))
    fi
  done
  if [ "$ref_failures" -ne 0 ]; then
    die "$ref_failures references/ checkout(s) did not land correctly in $wt. The worktree
exists, but a reference-reading gate would SKIP there and \`make docs-check\` would
still report green. Re-create the worktree rather than trusting a gate run in it."
  fi
fi

echo
echo "Worktree ready: $wt"
echo "  branch:  $(git -C "$wt" rev-parse --abbrev-ref HEAD)"
echo "  bundle:  vendor/bundle — CoW clone of the main clone, isolated and writable"
if [ "$with_references" -eq 0 ]; then
  echo "  refs:    references/ is NOT populated — a reference-reading gate will"
  echo "           silently SKIP here. Re-run with --with-references, or run"
  echo "           'make init-submodules' in the worktree, if a gate needs one."
fi
echo
echo "Work inside the Flake as usual. If this branch changes Gemfile.lock, run"
echo "'bundle install' in the worktree: it re-resolves against the clone and"
echo "diverges only the changed blocks."
