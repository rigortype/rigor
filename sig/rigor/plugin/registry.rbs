class Rigor::Plugin::Registry
  attr_reader plugins: untyped
  attr_reader load_errors: untyped
  attr_reader blueprints: untyped

  EMPTY: Rigor::Plugin::Registry

  def self.materialize: (blueprints: untyped, services: untyped) -> Rigor::Plugin::Registry

  def initialize: (?plugins: untyped, ?load_errors: untyped, ?blueprints: untyped) -> void
  def find: (String | Symbol id) -> Rigor::Plugin::Base?
  def ids: () -> Array[String]
  def empty?: () -> bool
  def any_load_errors?: () -> bool
  def type_node_resolvers: () -> Array[untyped]
  def rbs_complete_ancestors: () -> Array[String]
  def rbs_complete_ancestor?: (untyped class_name) -> bool

  # Newly declared — the attr_reader was absent from the sig. `compile_aggregates` builds the ivar
  # with `flat_map` over the manifests (not from an `initialize` parameter, so this is unmarked
  # residue like the `rbs_complete_ancestors` sibling rather than a #1154 row); the element type is
  # `AdditionalInitializer`, enforced per manifest by `validate_additional_initializers!`.
  attr_reader additional_initializers: Array[Rigor::Plugin::AdditionalInitializer]

  # Newly declared — same unmarked-residue shape as `additional_initializers` (a
  # `compile_aggregates` flat_map ivar, not an initialize-parameter read).
  attr_reader protocol_contracts: Array[Rigor::Plugin::ProtocolContract]

  # The subset of `protocol_contracts` whose `path_glob` matches `path` (memoised per path).
  def contracts_for_path: (untyped path) -> Array[Rigor::Plugin::ProtocolContract]

  # ADR-103 WD2/WD6/WD10/WD14 — every loaded plugin's effect contribution, in registration order.
  # Lazy and memoised like `contracts_for_path`: computing it can force a plugin's project-facts
  # read, which a run with effects off must never pay. Unmarked residue — a memoised flat_map
  # aggregate, not an `initialize`-parameter read.
  def effect_contributions: () -> Array[Contribution]

  # One plugin's effect contribution, flattened off whichever surface answered it. Carries the two
  # authority answers — `owner`, the label root this plugin may open, and `discharge_allowed`,
  # whether its attributions may discharge — so nothing downstream re-derives who is first-party.
  class Contribution < ::Data
    # sig-gen gap: #1150 — a `Data.define` member; sig-gen proposes `untyped`.
    attr_reader id: String
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader owner: String
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader requested_root: String?
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader discharge_allowed: bool
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader labels: Array[String]
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader attributions: Array[EffectAttribution]
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader edges: Array[EffectEdge]
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader entry_points: Array[EffectEntryPoints]
    # sig-gen gap: #1150 — a `Data.define` member.
    attr_reader ancestry: Array[EffectAncestry]

    # sig-gen gap: #1150 — `ancestry:` defaults so pre-#465 callers keep working; the custom
    # initialize takes keywords only, so the positional `self.[]` constructor is not callable.
    def self.new: (id: String, owner: String, requested_root: String?, discharge_allowed: bool,
                   labels: Array[String], attributions: Array[EffectAttribution],
                   edges: Array[EffectEdge], entry_points: Array[EffectEntryPoints],
                   ?ancestry: Array[EffectAncestry]) -> instance
    def initialize: (id: String, owner: String, requested_root: String?, discharge_allowed: bool,
                     labels: Array[String], attributions: Array[EffectAttribution],
                     edges: Array[EffectEdge], entry_points: Array[EffectEntryPoints],
                     ?ancestry: Array[EffectAncestry]) -> void

    # Whether the row carries nothing — no labels, attributions, edges, entry points, or ancestry.
    def empty?: () -> bool
  end
end
