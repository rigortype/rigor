class Rigor::Plugin::Manifest::Consumption
  def initialize: (plugin_id: untyped, name: untyped, ?optional: untyped) -> void
end

class Rigor::Plugin::Manifest
  def initialize: (id: untyped, version: untyped, ?description: untyped, ?config_schema: untyped, ?target_gems: untyped, ?produces: untyped, ?consumes: untyped, ?owns_receivers: untyped, ?open_receivers: untyped, ?rbs_complete_ancestors: untyped, ?type_node_resolvers: untyped, ?block_as_methods: untyped, ?heredoc_templates: untyped, ?nested_class_templates: untyped, ?trait_registries: untyped, ?hkt_registrations: untyped, ?hkt_definitions: untyped, ?signature_paths: untyped, ?protocol_contracts: Array[Rigor::Plugin::ProtocolContract], ?source_rbs_synthesizer: untyped, ?additional_initializers: Array[Rigor::Plugin::AdditionalInitializer], ?effect_root: String?, ?effect_labels: Array[String], ?effect_attributions: Array[Rigor::Plugin::EffectAttribution], ?effect_edges: Array[Rigor::Plugin::EffectEdge], ?effect_entry_points: Array[Rigor::Plugin::EffectEntryPoints], ?effect_ancestry: Array[Rigor::Plugin::EffectAncestry], ?template_globs: untyped) -> void

  # Public attribute readers (the full `attr_reader` surface). Plugins
  # read `manifest.id` / `manifest.protocol_contracts` etc.; declaring
  # them keeps the contract surface resolvable so ADR-43 ancestor
  # resolution does not surface a false `call.undefined-method` on a
  # real reader. Slots whose element classes are sig-covered carry the
  # validated element type (the `validate_*!` constructors prove it);
  # the rest stay `untyped` per the sparse `sig/` tree.
  def id: () -> String
  def version: () -> String
  def description: () -> String?
  def config_schema: () -> untyped
  def config_defaults: () -> Hash[String, untyped]
  def target_gems: () -> Array[String]
  # sig-gen gap: #1154 — an `attr_reader` over an ivar assigned in `initialize` from a parameter the
  # manifest validates but does not type, so inference reaches `untyped` where the contract is
  # `Array[String]` (the same gap every other reader in this block carries).
  def template_globs: () -> Array[String]
  def produces: () -> Array[Symbol]
  def consumes: () -> Array[Rigor::Plugin::Manifest::Consumption]
  def owns_receivers: () -> Array[String]
  def open_receivers: () -> Array[String]
  def rbs_complete_ancestors: () -> Array[String]
  def type_node_resolvers: () -> Array[Rigor::Plugin::TypeNodeResolver]
  def block_as_methods: () -> untyped
  def heredoc_templates: () -> untyped
  def nested_class_templates: () -> untyped
  def trait_registries: () -> untyped
  def hkt_registrations: () -> untyped
  def hkt_definitions: () -> untyped
  def signature_paths: () -> Array[String]
  # sig-gen gap: #1154 — `attr_reader` over an ivar assigned in `initialize` from a parameter;
  # `validate_protocol_contracts!` requires every element `is_a?(ProtocolContract)`.
  def protocol_contracts: () -> Array[Rigor::Plugin::ProtocolContract]
  # ADR-32 WD6/WD12 — any object responding to `call`, and its result is a documented multi-shape
  # outcome (`String` / nil / `[:error, msg]` / `[:ok, src, msgs]`), not `String?` — `untyped` is the
  # honest claim until the outcome has a sig'd shape.
  def source_rbs_synthesizer: () -> untyped
  # sig-gen gap: #1154 — `attr_reader` over an ivar assigned in `initialize` from a parameter;
  # the validator (`validate_additional_initializers!`) requires every element
  # `is_a?(AdditionalInitializer)`, so the element type is hand-written.
  def additional_initializers: () -> Array[Rigor::Plugin::AdditionalInitializer]

  # sig-gen gap: #1154 — `attr_reader` over an ivar assigned in `initialize` from a parameter
  # (`to_s`-normalized); `validate_effect_root!` bounds the spelling.
  def effect_root: () -> String?
  # sig-gen gap: #1154 — `attr_reader` over an ivar normalized in `initialize` from a parameter;
  # `validate_effect_labels!` requires non-empty `String` elements.
  def effect_labels: () -> Array[String]
  # sig-gen gap: #1154 — `attr_reader` over an ivar assigned in `initialize` from a parameter;
  # `validate_effect_attributions!` requires every element `is_a?(EffectAttribution)`.
  def effect_attributions: () -> Array[Rigor::Plugin::EffectAttribution]
  # sig-gen gap: #1154 — same shape; `validate_effect_edges!` requires `is_a?(EffectEdge)`.
  def effect_edges: () -> Array[Rigor::Plugin::EffectEdge]
  # sig-gen gap: #1154 — same shape; `validate_effect_entry_points!` requires
  # `is_a?(EffectEntryPoints)`.
  def effect_entry_points: () -> Array[Rigor::Plugin::EffectEntryPoints]
  # sig-gen gap: #1154 — same shape; `validate_effect_ancestry!` requires `is_a?(EffectAncestry)`.
  def effect_ancestry: () -> Array[Rigor::Plugin::EffectAncestry]

  # The identity opening a root when this plugin's labels join the run's vocabulary: the
  # `effect_root` for a bundled first-party plugin that declares one, the plugin `id` otherwise.
  def effect_owner: () -> String
  # Whether this plugin's `effect_attributions:` may carry `discharge: true` (ADR-103 WD6).
  def effect_discharge_allowed?: () -> bool
  # Whether the plugin contributes anything to the effect surfaces at all.
  def effects?: () -> bool

  def validate_config: (untyped) -> Array[String]
  def to_h: () -> Hash[String, untyped]
  def hash: () -> Integer
end
