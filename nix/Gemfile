# frozen_string_literal: true

# Runtime dependencies of the rigortype gem, mirrored from
# rigortype.gemspec. This Gemfile exists only to build the Nix
# package (packages.default in flake.nix): bundlerEnv resolves
# these third-party gems, and the derivation adds rigortype's own
# code on top. It deliberately does NOT use `gemspec` — that would
# pull in the development dependencies as well.
#
# Regenerate Gemfile.lock + gemset.nix after changing this file, and to
# re-resolve the pins to the latest in-range versions:
#
#   cd nix && bundle update && bundix
#
# `bundle lock` only fills gaps in an existing lockfile — it leaves the
# pinned versions alone, so it does not refresh this package when the
# root bundle moves. spec/docs/nix_lockfile_sync_spec.rb fails if the
# versions here no longer match the root Gemfile.lock.
#
source "https://rubygems.org"

gem "language_server-protocol", ">= 3.17", "< 4.0"
gem "prism", ">= 1.0", "< 2.0"
gem "rbs", ">= 3.0", "< 5.0"
