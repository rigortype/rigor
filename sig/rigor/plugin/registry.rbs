class Rigor::Plugin::Registry
  attr_reader plugins: untyped
  attr_reader load_errors: untyped
  attr_reader blueprints: untyped

  EMPTY: Rigor::Plugin::Registry

  def self.materialize: (blueprints: untyped, services: untyped) -> Rigor::Plugin::Registry

  def initialize: (?plugins: untyped, ?load_errors: untyped, ?blueprints: untyped) -> void
  def find: (String | Symbol id) -> Rigor::Plugin::Base?
  def ids: () -> Array[String]
  def empty?: () -> bool
  def any_load_errors?: () -> bool
  def type_node_resolvers: () -> Array[untyped]
  def rbs_complete_ancestors: () -> Array[String]
  def rbs_complete_ancestor?: (untyped class_name) -> bool

  # Newly declared — the attr_reader was absent from the sig. `compile_aggregates` builds the ivar
  # with `flat_map` over the manifests (not from an `initialize` parameter, so this is unmarked
  # residue like the `rbs_complete_ancestors` sibling rather than a #1154 row); the element type is
  # `AdditionalInitializer`, enforced per manifest by `validate_additional_initializers!`.
  attr_reader additional_initializers: Array[Rigor::Plugin::AdditionalInitializer]

  # Newly declared — same unmarked-residue shape as `additional_initializers` (a
  # `compile_aggregates` flat_map ivar, not an initialize-parameter read).
  attr_reader protocol_contracts: Array[Rigor::Plugin::ProtocolContract]

  # The subset of `protocol_contracts` whose `path_glob` matches `path` (memoised per path).
  def contracts_for_path: (untyped path) -> Array[Rigor::Plugin::ProtocolContract]
end
