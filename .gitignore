/.bundle/
/.direnv/
**/.rigor/cache/
# Developer-local Rigor config override. The committed default is
# `.rigor.dist.yml`; auto-discovery prefers `.rigor.yml` when present
# (no implicit merge).
/.rigor.yml
/coverage/
/coverage_report.txt
/pkg/
/tmp/
/vendor/bundle/
/tool/*/vendor/bundle/
/result
/playground/backend/Gemfile.lock
# `make bench` writes the suggested baseline here (ADR-50 WD4); the
# committed, calibrated baseline is bench/baseline.json.
/bench/baseline.updated.json

# Skill-creator eval workspaces (transient; results belong in the session, not the tree)
/*-workspace/

# The contributor skills under `.claude/skills/` are version-controlled, but a
# developer's global excludesfile commonly ignores `.claude` wholesale — which
# leaves them tracked only because they were force-added once, and makes any NEW
# skill file invisible to `git status`. Re-include the directory here so the
# repository decides, then keep everything else in it out: `settings.local.json`
# holds per-machine tool permissions, and the desktop app creates checkouts under
# `.claude/worktrees/`.
!/.claude/
/.claude/*
!/.claude/skills/

# TAKT local trial artifacts
.takt/runs/
.takt/tasks/
.takt/tasks.yaml
.takt/events/

# pi project-local install artifacts (keep .pi/settings.json tracked)
.pi/*
!.pi/settings.json
