module Rigor
  module Plugin
    # One `effect_edges:` row: a framework-edge strategy naming the base `receiver` a plugin points
    # the engine at, the `target` strategy slot, and an optional method-level `selector`. Frozen
    # value object.
    class EffectEdge
      # The closed set of framework-edge strategies the engine implements.
      TARGETS: Array[Symbol]

      # sig-gen gap: #2312 — `receiver:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `to_s`), and `initialize`
      # stores the result of the private `validate_receiver!` helper (#2312).
      attr_reader receiver: String
      # sig-gen gap: #2321 — `method:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `String | Symbol | nil`),
      # stored as `method&.to_sym`.
      attr_reader method: Symbol?
      attr_reader singleton: bool
      # sig-gen gap: #2312 — `target:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: a Symbol or String checked
      # against `TARGETS`), stored from the private `validate_target!` helper (#2312).
      attr_reader target: (:activerecord_callbacks | :perform_now | :mailer_body)
      # sig-gen gap: #2312 — `why:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `to_s`), stored from the
      # private `validate_why!` helper (#2312).
      attr_reader why: String

      def initialize: (receiver: untyped, target: untyped, why: untyped, ?method: untyped,
                       ?singleton: untyped) -> void

      def to_h: () -> Hash[String, untyped]

      def ==: (untyped other) -> bool
      # `alias eql? ==` — the alias row has no sig-gen shape, so it stays unmarked
      # residue.
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
  end
end
