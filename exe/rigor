#!/usr/bin/env ruby
# frozen_string_literal: true

# ADR-39 slice 5 — the `ruby_box` plugin-isolation strategy needs the
# experimental `Ruby::Box` feature, which is a process-start flag
# (`RUBY_BOX=1`, not toggleable at runtime). When a project selects that
# strategy (`RIGOR_PLUGIN_ISOLATION=ruby_box`, or the legacy `RIGOR_BOX`
# alias) we re-exec the same command with the flag set before anything
# else loads. The inherited environment (RUBYOPT / BUNDLE_*) preserves the Bundler
# context across the exec. The `none` and `process` (default) strategies
# need no flag, so this is a no-op for them — behaviour is unchanged
# unless a project opts into `ruby_box`.
#
# Before re-exec'ing, a child Ruby probes whether this Ruby can run
# Rigor under `RUBY_BOX=1` at all (Rigor::Plugin::BoxProbe — released
# Rubies through 4.0.7 segfault on Ruby Bug #22260). When it cannot,
# the request is dropped with a warning and the run proceeds under the
# configured strategy (`process` by default) instead of crashing.
#
# When `RUBY_BOX` is already set (by hand or by a wrapper), this process
# booted inside the box before any Rigor code ran, so the same probe
# runs here too, and a refused Ruby is re-exec'ed with `RUBY_BOX`
# removed. The probe's verdict is cached per Ruby build, and the
# re-exec is marked so the child neither probes nor re-execs again.
# Nothing above `require "rigor/cli"` may define a Ractor-shareable
# lambda: that is what crashes inside the box.
if !ENV["RUBY_BOX"].to_s.empty? || ENV["RIGOR_PLUGIN_ISOLATION"].to_s == "ruby_box" ||
   !ENV["RIGOR_BOX"].to_s.empty? || ENV.key?("RIGOR_BOX_PROBED")
  require_relative "../lib/rigor/plugin/box_probe"
  exec(RbConfig.ruby, __FILE__, *ARGV) if Rigor::Plugin::BoxProbe.prepare_launch(ENV)
end

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) if File.directory?(lib) && !$LOAD_PATH.include?(lib)

require "rigor/cli"

exit Rigor::CLI.start(ARGV)
