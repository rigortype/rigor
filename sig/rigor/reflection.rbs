module Rigor
  module Reflection
    def self?.class_known?: (String | Symbol class_name, ?scope: Scope) -> bool
    def self?.rbs_class_known?: (String | Symbol class_name, ?scope: Scope) -> bool
    def self?.project_declared_class?: (String | Symbol class_name, ?scope: Scope?, ?environment: Environment?) -> bool
    def self?.class_ordering: (String | Symbol lhs, String | Symbol rhs, ?scope: Scope) -> (:disjoint | :equal | :subclass | :superclass | :unknown)
    def self?.nominal_for_name: (String | Symbol class_name, ?scope: Scope) -> Type::Nominal?
    def self?.singleton_for_name: (String | Symbol class_name, ?scope: Scope) -> Type::Singleton?
    def self?.constant_type_for: (String | Symbol constant_name, ?scope: Scope) -> Type::t?
    def self?.resolve_constant_type: (String | Symbol name, ?scope: Scope, ?rooted: bool, ?caller_derived: bool) -> Type::t?
    # sig-gen gap: #1157 — sig-gen skips the method (untyped return: the `&known` block-taking resolver
    # declines through `nil` paths), so the resolved-name-or-decline is hand-written.
    def self?.resolve_constant_path_name: (String | Symbol name, Scope scope) { (String candidate) -> boolish } -> String?
    def self?.lexical_nesting_chain: (Scope scope) -> Array[String]
    def self?.instance_method_definition: (String | Symbol class_name, String | Symbol method_name, ?scope: Scope) -> ::RBS::Definition::Method?
    def self?.singleton_method_definition: (String | Symbol class_name, String | Symbol method_name, ?scope: Scope) -> ::RBS::Definition::Method?
    def self?.instance_definition: (String | Symbol class_name, ?scope: Scope) -> ::RBS::Definition?
    def self?.singleton_definition: (String | Symbol class_name, ?scope: Scope) -> ::RBS::Definition?
    def self?.class_type_param_names: (String | Symbol class_name, ?scope: Scope) -> Array[Symbol]
    def self?.discovered_class?: (String | Symbol class_name, ?scope: Scope) -> bool
    def self?.discovered_method?: (String | Symbol class_name, String | Symbol method_name, ?kind: Symbol, ?scope: Scope) -> bool
    def self?.project_method_defined: (String | Symbol? class_name, String | Symbol method_name, kind: :instance | :singleton, source: :def | :discovered | :either, scope: Scope) -> Trinary
    def self?.rbs_method_defined: (String | Symbol? class_name, String | Symbol method_name, kind: :instance | :singleton, scope: Scope) -> Trinary
    def self?.ancestry_reaches: (String | Symbol? class_name, Array[String | Symbol] ancestor_names, kind: :instance | :singleton, scope: Scope) -> Trinary
    # sig-gen gap: #2302 — the collector's `@classes = []` is grown by `<<`, so sig-gen reads the array as `Array[untyped]`.
    def self?.class_declarations_in: (Prism::Node root) ?{ (DeclaredCall call) -> void } -> Array[ClassDeclaration]

    # One `class` header of a parsed file, as `class_declarations_in` reports it.
    class ClassDeclaration < Data
      # sig-gen gap: #1150 — `Data.define` members carry no type, so sig-gen proposes `untyped`; the shape is hand-written.
      attr_reader name: String
      # sig-gen gap: #1150 — `Data.define` members carry no type, so sig-gen proposes `untyped`; the shape is hand-written.
      attr_reader nesting: Array[String]
      # sig-gen gap: #1150 — `Data.define` members carry no type, so sig-gen proposes `untyped`; the shape is hand-written.
      attr_reader node: Prism::ClassNode

      # sig-gen gap: #1150 — `Data.define` members carry no type, so the constructor's keywords are `untyped` in sig-gen.
      def self.new: (name: String, nesting: Array[String], node: Prism::ClassNode) -> instance
                  | (String name, Array[String] nesting, Prism::ClassNode node) -> instance
      # sig-gen gap: #1150 — `Data.define` members carry no type, so the constructor's keywords are `untyped` in sig-gen.
      def self.[]: (name: String, nesting: Array[String], node: Prism::ClassNode) -> instance
                 | (String name, Array[String] nesting, Prism::ClassNode node) -> instance
    end

    # One call `class_declarations_in` yields: the `Prism::CallNode` and the class or module it lexically sits in.
    class DeclaredCall < Data
      # sig-gen gap: #1150 — `Data.define` members carry no type, so sig-gen proposes `untyped`; the shape is hand-written.
      attr_reader node: Prism::CallNode
      # sig-gen gap: #1150 — `Data.define` members carry no type, so sig-gen proposes `untyped`; the shape is hand-written.
      attr_reader owner: String?

      # sig-gen gap: #1150 — `Data.define` members carry no type, so the constructor's keywords are `untyped` in sig-gen.
      def self.new: (node: Prism::CallNode, owner: String?) -> instance
                  | (Prism::CallNode node, String? owner) -> instance
      # sig-gen gap: #1150 — `Data.define` members carry no type, so the constructor's keywords are `untyped` in sig-gen.
      def self.[]: (node: Prism::CallNode, owner: String?) -> instance
                 | (Prism::CallNode node, String? owner) -> instance
    end
  end
end
