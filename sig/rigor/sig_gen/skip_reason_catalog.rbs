# `Rigor::SigGen` itself has no other declaration under `sig/`; without this shell `rbs validate`
# rejects the two declarations below with `Could not find ::Rigor::SigGen`.
module Rigor::SigGen
end

# Every entry is built from string literals in `SkipReasonCatalog::ENTRIES`, so the four readers
# answer `String`.
class Rigor::SigGen::SkipReasonCatalog::Entry < ::Data
  def id: () -> String
  def summary: () -> String
  def explanation: () -> String
  def next_step: () -> String
  def self.new: (id: String, summary: String, explanation: String, next_step: String) -> instance | (String id, String summary, String explanation, String next_step) -> instance
  def self.[]: (id: String, summary: String, explanation: String, next_step: String) -> instance | (String id, String summary, String explanation, String next_step) -> instance
  def to_h: () -> Hash[String, String]
end

module Rigor::SigGen::SkipReasonCatalog
  def self?.resolve: (untyped) -> Rigor::SigGen::SkipReasonCatalog::Entry?
  def self?.all: () -> Array[Rigor::SigGen::SkipReasonCatalog::Entry]
end
