module Rigor
  module Plugin
    # One `effect_entry_points:` row: a named set of globs marking project files whose methods are
    # framework entry points (ADR-103 WD6). Frozen value object; {#globs} are deduplicated and
    # sorted in `initialize`.
    class EffectEntryPoints
      # sig-gen gap: #2321 — `initialize` declares `name:` `untyped` (input `untyped`, looks deliberate; a declared
      # type is authoring intent tracked by #2325, and only then does this row generate; coercion-facing: it takes
      # anything that answers `to_s`), so no input type reaches the reader.
      attr_reader name: String
      # sig-gen gap: #2321 — `globs:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `Array(globs)`, each `to_s`),
      # deduplicated and sorted in `initialize`.
      attr_reader globs: Array[String]
      # sig-gen gap: #2321 — `why:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `to_s`).
      attr_reader why: String

      def initialize: (name: untyped, globs: untyped, ?why: untyped) -> void

      def to_h: () -> Hash[String, untyped]

      def ==: (untyped other) -> bool
      # `alias eql? ==` — the alias row has no sig-gen shape, so it stays unmarked
      # residue.
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
  end
end
