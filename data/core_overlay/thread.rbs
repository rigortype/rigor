# Rigor core overlay — supplemental core signatures.
#
# --- Thread::Backtrace::Location#source_range and Ruby::SourceRange (Ruby 4.1) ---
#
# Issue #1691. Ruby 4.1 adds `Thread::Backtrace::Location#source_range`
# (`vm_backtrace.c`, call-seq `location.source_range -> Ruby::SourceRange`)
# and the `Ruby::SourceRange` class it answers (`proc.c`), whose readers
# are, per their call-seqs:
#
#   path -> String               absolute_path -> String or nil
#   start_line -> Integer        start_column -> Integer
#   end_line -> Integer          end_column -> Integer
#
# `Ruby::SourceRange` has no allocator (`new` is undefined), so no
# constructor is declared. No rbs release through 4.2 declares either, so
# correct 4.1 code reported `call.undefined-method`.
#
# TEMPORARY: delete this file once the rbs release Rigor bundles declares
# the methods upstream.
#
# Declared unconditionally, not gated on `target_ruby` (ADR-121 § Rejected
# alternatives; false positives outrank). Every method sits on a module the
# class includes, so that a later direct declaration from rbs or a project
# `sig/` overrides it instead of raising `DuplicatedMethodDefinitionError`
# for the whole class (see `process.rbs`). `Ruby::SourceRange` is declared
# without a superclass, so a later upstream `< Object` reopening agrees.
module RigorCoreOverlay
  module Ruby41BacktraceLocation
    def source_range: () -> Ruby::SourceRange
  end

  module Ruby41SourceRange
    def path: () -> String

    def absolute_path: () -> String?

    def start_line: () -> Integer

    def start_column: () -> Integer

    def end_line: () -> Integer

    def end_column: () -> Integer
  end
end

class Thread::Backtrace::Location
  include RigorCoreOverlay::Ruby41BacktraceLocation
end

module Ruby
  class SourceRange
    include RigorCoreOverlay::Ruby41SourceRange
  end
end
