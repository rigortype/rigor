class Cap
  def self.take: (StringIO) -> String
  def self.file: (File) -> String
  def self.text: (String) -> String
  def self.count: (Integer) -> Integer
end

class Ret
  def out: () -> StringIO
  def out_copy: () -> StringIO
  def separator: () -> String
  def verbose: () -> bool
  def out_count: () -> Integer
end
