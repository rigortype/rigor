module AcLibraryRb
  # A segment tree over the monoid `(S, op, e)`.
  class Segtree[S]
    attr_reader d: Array[S]
    attr_reader op: _Call2[S, S, S]
    attr_reader n: Integer
    attr_reader leaf_size: Integer
    attr_reader log: Integer

    def initialize: (Array[S] | Integer v, S e) { (S, S) -> S } -> void
                  | (Array[S] | Integer v, _Call2[S, S, S] op, S e) -> void

    def set: (Integer pos, S x) -> void
    alias []= set

    def get: (Integer pos) -> S
    alias [] get

    def prod: (Integer l, Integer r) -> S
            | (Range[Integer] range) -> S

    def all_prod: () -> S

    def max_right: (Integer l) { (S) -> boolish } -> Integer

    def min_left: (Integer r) { (S) -> boolish } -> Integer

    def update: (Integer k) -> S
  end

  class SegTree = Segtree

  # A lazy segment tree over the monoid `(S, op, e)` acted on by the maps `(F, composition, id)`, where
  # `mapping.call(f, x)` applies `f` to `x` and `composition.call(f, g)` is `f` after `g`.
  class LazySegtree[S, F]
    attr_reader d: Array[S]
    attr_reader lz: Array[F]
    attr_reader e: S
    attr_reader id: F
    attr_accessor op: _Call2[S, S, S]
    attr_accessor mapping: _Call2[F, S, S]?
    attr_accessor composition: _Call2[F, F, F]?

    # The first form is chosen when the second argument is a `Proc`.
    def initialize: (Array[S] | Integer v, ^(S, S) -> S op, S e, _Call2[F, S, S] mapping,
                     _Call2[F, F, F] composition, F id) -> void
                  | (Array[S] | Integer v, S e, F id, ?_Call2[S, S, S]? op, ?_Call2[F, S, S]? mapping,
                     ?_Call2[F, F, F]? composition) ?{ (S, S) -> S } -> void

    def set_mapping: () { (F, S) -> S } -> Proc

    def set_composition: () { (F, F) -> F } -> Proc

    def set: (Integer pos, S x) -> void
    alias []= set

    def get: (Integer pos) -> S
    alias [] get

    def prod: (Integer l, Integer r) -> S
            | (Range[Integer] range) -> S

    def all_prod: () -> S

    def apply: (Integer pos, F f) -> void
             | (Integer l, Integer r, F f) -> void
             | (Range[Integer] range, F f) -> void

    def range_apply: (Integer l, Integer r, F f) -> void

    def max_right: (Integer l) { (S) -> boolish } -> Integer

    def min_left: (Integer r) { (S) -> boolish } -> Integer

    def update: (Integer k) -> S

    def all_apply: (Integer k, F f) -> void

    def push: (Integer k) -> void
  end

  class LazySegTree = LazySegtree
end
