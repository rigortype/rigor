#!/usr/bin/env bash
# The local pre-push gate: check only what this branch changed, in under a minute.
#
# The full gate (`make verify`) belongs to the PR's full CI run, at `gh pr ready`
# (a Draft PR gets only a light gate): locally it runs the whole suite, and several parallel sessions running it at once is what
# stalls the host (five at once took 12-20 minutes each in September 2026).
# This script covers the checks a session can answer cheaply before pushing,
# over the files changed since the merge base (committed, uncommitted and
# untracked):
#
#   1. whitespace errors (`git diff --check`, and the same check on untracked files);
#   2. RuboCop on the changed files `make lint` covers;
#   3. RSpec on the changed specs; the mirror spec of a changed lib/ or tool/ file,
#      and every spec under its mirror directory (`lib/rigor/a/b.rb` selects
#      `spec/rigor/a/b_spec.rb` and every `*_spec.rb` below `spec/rigor/a/b/`,
#      for the files that have no same-named spec);
#      the specs that name a changed fixture — by its directory path when it
#      lives under a fixtures/ tree, since `demo.rb` alone names dozens of
#      fixture directories; for a changed plugin or example,
#      the integration specs that load it plus the two all-plugin conformance
#      specs — the opt-in files in their own processes, as in `verify`; and
#      for any engine change (lib/, sig/, data/) the whole-engine drift specs
#      that CI failures most often came from on untouched files (~45s), and every
#      example that pins a known-wrong answer with "flip this when #N" (~7s): an
#      engine change can fix #N in passing, and the pin then fails in a file the
#      branch never touched (#2003); and, for a lib/ edit that touches how the
#      engine records ADR-46 dependencies, the incremental specs that assert a
#      reader is not re-checked (~90s), which no mirror spec names (#2136);
#   4. `spec/docs/` always — seconds, and it is where the Markdown gates live;
#   5. `rigor check --fail-on=warning` on the changed lib files and the lib
#      mirrors of changed sig/ files — the CI self-check caught a
#      `String | Symbol` argument on PR #1301 that every spec passed.
#
# What it cannot see — a regression in a file the branch did not touch, which is
# what an engine change or a deletion risks — is the reason CI stays the gate.
# Changes it knows it cannot cover are listed at the end instead of passing
# silently.
#
# Usage: bin/verify-changed [base] [--quick] [--list-specs]   (base defaults to
# origin/master; run it inside the Flake, e.g. via `make verify-changed`)
#
# --quick is the edit-loop tier (`make verify-quick`), NOT the pre-push gate:
# whitespace, RuboCop on the changed files, and RSpec on only the directly
# selected specs — changed specs, mirror specs (file and directory), and specs
# naming a changed fixture. It skips, and says so in its closing lines:
#   - the whole-engine drift specs a lib/, sig/ or data/ change adds;
#   - the "flip this when #N" pins;
#   - the incremental "not re-checked" specs;
#   - `spec/docs/`;
#   - the `rigor check` self-check.
# For a changed plugin or example file it keeps what the default mode selects
# (the integration specs that load it, and for plugins/*/lib the declaration-fact
# and ancestry-walker gates, ~4s) except the two all-plugin conformance specs
# (all_plugins_load_spec, plugin_contract_conformance_spec). A changed spec under
# spec/rigor/declaration_facts/ still runs its four gates, as a changed spec
# does. Its exit status reflects the checks it ran; `bin/lane-push` runs the
# default mode and accepts no --quick. Run `make verify-changed` before pushing.
#
# --list-specs prints the specs the selection picked and exits before any check
# runs — spec/tool/verify_changed_spec.rb drives it with VERIFY_CHANGED_PATHS
# (newline-separated paths standing in for the diff) to pin the selection.

set -uo pipefail

list_only=""
quick=""
base_ref=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list-specs) list_only=1 ;;
    --quick) quick=1 ;;
    -*) echo "verify-changed: unknown option $1" >&2; exit 2 ;;
    *) base_ref="$1" ;;
  esac
  shift
done
base_ref="${base_ref:-${VERIFY_BASE:-origin/master}}"
# The hook replaces the diff, so outside --list-specs it would run the checks
# over a selection that is not this tree's and still print OK.
if [[ -n "${VERIFY_CHANGED_PATHS:-}" && -z "$list_only" ]]; then
  echo "verify-changed: VERIFY_CHANGED_PATHS stands the diff in for --list-specs only" >&2
  exit 2
fi
if ! merge_base="$(git merge-base HEAD "$base_ref" 2>/dev/null)"; then
  echo "verify-changed: cannot find a merge base with $base_ref (git fetch origin?)" >&2
  exit 2
fi

# NUL-separated reads keep spaces and non-ASCII names intact (core.quotePath
# would otherwise hand back a quoted name that fails every -f test).
changed=()
if [[ -n "${VERIFY_CHANGED_PATHS:-}" ]]; then
  # Test hook: the listed paths stand in for the whole diff, verbatim — no -f
  # filter, so a path that does not exist can still exercise the fallbacks.
  while IFS= read -r path; do
    [[ -n "$path" ]] && changed+=("$path")
  done <<< "$VERIFY_CHANGED_PATHS"
else
  while IFS= read -r -d '' path; do
    [[ -f "$path" ]] && changed+=("$path")
  done < <({ git diff -z --name-only --diff-filter=d "$merge_base"; git ls-files -z --others --exclude-standard; } | sort -zu)
fi
untracked=()
while IFS= read -r -d '' path; do untracked+=("$path"); done < <(git ls-files -z --others --exclude-standard)
deleted=()
if [[ -z "${VERIFY_CHANGED_PATHS:-}" ]]; then
  while IFS= read -r -d '' path; do deleted+=("$path"); done < <(git diff -z --name-only --diff-filter=D "$merge_base")
fi

# In list mode stdout carries only the spec list, so the banner goes to stderr.
if [[ -n "$quick" && -z "$list_only" ]]; then
  echo "verify-changed --quick: the EDIT-LOOP tier, not the pre-push gate."
  echo "It checks the directly selected specs only; the closing lines list what it skips."
fi
if [[ -n "$list_only" ]]; then
  echo "verify-changed: ${#changed[@]} changed and ${#deleted[@]} deleted file(s)" \
    "since $(git rev-parse --short "$merge_base") ($base_ref)" >&2
else
  echo "verify-changed: ${#changed[@]} changed and ${#deleted[@]} deleted file(s)" \
    "since $(git rev-parse --short "$merge_base") ($base_ref)"
fi

failures=()
step() {
  local name="$1"
  shift
  echo
  echo "== $name"
  echo "\$ $*"
  "$@" || failures+=("$name")
}

# `git diff --check` never sees an untracked file; `--no-index` against
# /dev/null does, and exits 1 for any difference, so judge by its output.
check_untracked_whitespace() {
  local path out status=0
  for path in "$@"; do
    out="$(git diff --no-index --check /dev/null "$path")"
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      status=1
    fi
  done
  return "$status"
}

if [[ -z "$list_only" ]]; then
  step "git diff --check" git diff --check "$merge_base"
  if ((${#untracked[@]})); then
    step "whitespace (untracked files)" check_untracked_whitespace "${untracked[@]}"
  fi
fi

# Newline-separated lists, de-duplicated by `lines` below: the host's /bin/bash
# is 3.2 (no namerefs, and an empty "${a[@]}" trips `set -u`), so no array sets.
lint_files=""
specs=""
pool_specs=""
plugin_specs=""
check_files=""
uncovered=""
engine_changed=""
add_spec() {
  case "$1" in
    spec/rigor/analysis/runner_pool_spec.rb) pool_specs+="$1"$'\n' ;;
    spec/integration/plugins/*_spec.rb | spec/integration/examples/*_spec.rb) plugin_specs+="$1"$'\n' ;;
    *) specs+="$1"$'\n' ;;
  esac
}
add_mirror_spec() { [[ -f "$1" ]] && add_spec "$1"; }
# add_mirror_dir_specs <spec path without .rb>: every spec below the mirror
# directory, for a module that has a spec directory and no same-named spec
# (`lib/rigor/analysis/check_rules.rb` and `spec/rigor/analysis/check_rules/`).
add_mirror_dir_specs() {
  local spec
  [[ -d "$1" ]] || return 0
  while IFS= read -r spec; do add_spec "$spec"; done < <(find "$1" -name '*_spec.rb' | sort)
}
# ere_literal <string>: the string as an ERE that matches only itself. A `.` in
# a fixture directory name would otherwise match any character, and because a
# coincidental hit counts as a match it would also suppress the basename route.
# Both calls are load-bearing. Under the anchored pattern each site uses, ten
# fixture basenames select differently unescaped — `.keep` 0 against 39,
# `a.rb` 179 against 180 — and one of them, `prepend.rb` under
# `arity_differential/survivors/`, reaches the basename route at all, because
# its directory names no spec. Dropping either escape is pinned.
ere_literal() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_/-]/\\&/g'; }
# spec_paths_matching <extended regex>: the spec files whose text matches, sorted.
spec_paths_matching() { grep -rlE --include='*_spec.rb' "$1" spec | sort -u; }
# add_specs_matching <extended regex>: every spec file whose text matches.
add_specs_matching() {
  local spec
  while IFS= read -r spec; do add_spec "$spec"; done < <(spec_paths_matching "$1")
}
# fixture_dirs_matching <path below a fixtures/ root>: a file inside
# `fixtures/effects/tracer/` is named in specs by a directory prefix of its
# path (`effects/tracer` for the fixture's own specs, `effects` for a spec
# that globs the container). Every ancestor is tried deepest-first: the first
# level a spec names is the precise match, and a shallower level may still add
# the specs that name the fixture more broadly — but only while it adds few,
# so a container name like `effects` cannot re-select every spec that says
# "effects". The cap is on NEW specs per level; the deepest match is never
# capped. Returns success when any level matched.
#
# Neither cap is tight: over every path in the tree today any shallower-level
# cap from 1 to 80, and any basename cap from 5 up, give the same selection
# (the largest basename count taken is 4). They are there to refuse a container
# word, not calibrated, so a future reviewer need not reverse-engineer the 10.
#
# A capped level is dropped whole, so this is correct only while a spec that
# reads one project under a container names that project's own directory
# (`fixtures/effects/rails`), not just the container. Every effects and sig_gen
# spec does today. A spec that stopped doing so would lose its fixture here
# with no gate noticing.
fixture_dirs_matching() {
  local rest="$1" dir matches added result="" spec
  while [[ "$rest" == */* ]]; do
    dir="${rest%/*}"
    matches="$(spec_paths_matching "(^|[^A-Za-z0-9_])$(ere_literal "$dir")([^A-Za-z0-9_]|$)")"
    if [[ -n "$matches" ]]; then
      if [[ -z "$result" ]]; then
        result="$matches"
      else
        added="$(comm -13 <(printf '%s\n' "$result") <(printf '%s\n' "$matches") | grep -c .)"
        (( added <= 10 )) && result="$(printf '%s\n%s\n' "$result" "$matches" | sort -u)"
      fi
    fi
    rest="$dir"
  done
  [[ -z "$result" ]] && return 1
  while IFS= read -r spec; do add_spec "$spec"; done <<< "$result"
  return 0
}
lines() { printf '%s' "$1" | sort -u; }
# Specs that read the whole engine rather than one file: a lib change anywhere
# can move them. They were most of the CI failures (Sept 2026) that a
# changed-files-only gate would have missed.
#
# provenance_spec (ADR-107 G3) is the mirror of no file, yet all three engine
# trees move it: it pins each sig/ file's unmarked hand-written residue, and it
# runs `sig-gen` over lib/ to decide which rows are earned, so a sig/ row, an
# inference change in lib/, or a data/ catalogue that changes what sig-gen
# proves can each break a pin (#1449, #1453: CI-only both times). It adds its
# generator pass at file load, about 10s on an idle host.
provenance_spec=spec/rigor/sig_gen/provenance_spec.rb
# The declaration-fact gates (#1507) read every file under lib/ and plugins/*/lib/,
# so any change there can move them; together they take about 3s. Their own
# fixtures, snapshots and support files run exactly these four.
declaration_fact_specs=(
  spec/rigor/declaration_facts/admission_census_spec.rb
  spec/rigor/declaration_facts/member_classes_spec.rb
  spec/rigor/declaration_facts/producers_spec.rb
  spec/rigor/declaration_facts/witness_spec.rb
)
# The ancestry-walker gate (ADR-24) Prism-scans every file under lib/ and
# plugins/*/lib/ for methods that walk the discovery tables' ancestry outside
# Scope::ResolutionChain; its allow-list and its scanner
# (spec/support/ancestry_walker_scan.rb) are pins any lib or plugin-lib change
# can stale. It runs in about 1s. Added for #2053: on #2051 this gate passed and
# CI shard 2/3 then failed on a new lib file it never ran.
ancestry_walker_spec=spec/rigor/scope/ancestry_walker_detection_spec.rb
# An edit to how the engine records ADR-46 dependencies can over-invalidate
# files no spec of the edited file names: #2136 failed CI twice on
# incremental specs that assert a reader is NOT re-checked
# (`expect(...affected).not_to include`, or an exact `affected` set). Such an
# edit runs every incremental spec carrying such a precision assertion
# (10 files, ~95s), chosen by content so a new one joins on its own. The
# trigger is a changed line naming the recorder's surface, or a changed or
# deleted file of the incremental machinery itself.
dependency_recording_re='DependencyRecorder|parameter_envelopes_of|record_class_dependency|read_last_segment|read_missing|read_name\(|withhold|settle_by_(definitions|walk)|subclass_of|\(:mark,|"mark:'
precision_assertion_re='affected[^ ]*\)?\.not_to include|not_to include\(File\.join|affected[^ ]*\)\.to (eq|be_empty|contain_exactly)|result\)\.not_to include'
dependency_edit=""
# The two gates that take their inputs by enumerating the fixture tree at run
# time, rather than by naming a fixture: the precision snapshot gate walks
# `spec/integration/fixtures/` (flat `*.rb`, and every directory carrying the
# harness entry file), and the ADR-129 G4 reachability audit globs its flat
# `*.rb`. Neither spec's text holds a fixture or snapshot name, so no identifier
# rule below can reach them and both are named by path.
snapshot_gate_spec=spec/integration/precision_snapshot_spec.rb
flat_fixture_audit_spec=spec/rigor/typing_state_reachability_spec.rb
engine_drift_specs=(
  "$snapshot_gate_spec"
  spec/integration/type_construction_spec.rb
  spec/rigor/public_api_drift_spec.rb
  spec/rigor/ractor_readiness_spec.rb
  "$provenance_spec"
  "${declaration_fact_specs[@]}"
  "$ancestry_walker_spec"
)

for path in ${changed[@]+"${changed[@]}"}; do
  case "$path" in
    lib/* | spec/* | plugins/* | examples/* | apps/*) lint_files+="$path"$'\n' ;;
  esac
  case "$path" in
    lib/* | sig/* | data/* | .rigor.dist.yml)
      [[ -z "$quick" ]] && for spec in "${engine_drift_specs[@]}"; do add_spec "$spec"; done
      engine_changed=1
      ;;
    plugins/*/lib/*)
      for spec in "${declaration_fact_specs[@]}"; do add_spec "$spec"; done
      add_spec "$ancestry_walker_spec"
      ;;
  esac
  case "$path" in
    spec/rigor/declaration_facts/* | spec/integration/fixtures/declaration_witness/* | spec/support/declaration_*)
      for spec in "${declaration_fact_specs[@]}"; do add_spec "$spec"; done
      ;;
    spec/spec_helper.rb | spec/support/* | spec/*/support/*)
      uncovered+="$path (shared spec setup: the suite depends on it)"$'\n'
      # The G3 classifier and its helpers: provenance_spec is their only user.
      [[ "$path" == spec/support/sig_* ]] && add_spec "$provenance_spec"
      # The ancestry-walker scan: the detection spec is its only user.
      [[ "$path" == spec/support/ancestry_walker_scan.rb ]] && add_spec "$ancestry_walker_spec"
      ;;
    spec/*_spec.rb) add_spec "$path" ;;
    spec/integration/snapshots/*)
      # The only consumer enumerates this directory at run time
      # (precision_snapshot_spec.rb's SNAPSHOTS_DIR), so no spec's text holds a
      # snapshot's name and no identifier rule can reach it. Name it here.
      add_spec "$snapshot_gate_spec"
      ;;
    spec/*)
      # A fixture: run the specs that name it. Under a fixtures/ tree the
      # directory path is the identifier; a flat fixture (`fixtures/x.rb`) or a
      # directory lookup that names no spec falls back to the basename.
      base="$(basename "$path")"
      before="$specs$pool_specs$plugin_specs"
      matched=""
      # The mirror of the snapshots arm above: both run-time-enumerating gates
      # take this tree as their input, and a fixture with no golden FAILS, so a
      # fixture that reaches neither is a hole the gate reports as covered-by-
      # nothing while CI fails on it. Name them by each gate's own
      # discriminator — a flat `*.rb` feeds both, a directory feeds the snapshot
      # gate only when it carries the harness entry file, which is exactly what
      # `FixtureHarness#load_project` requires — so a container of per-spec
      # project trees (`fixtures/effects/`) is correctly left out. This does not
      # set `matched`: the identifier routes still run, since these two gates
      # are additional consumers, not the fixture's own spec.
      if [[ "$path" == spec/integration/fixtures/* ]]; then
        fixture_rest="${path#spec/integration/fixtures/}"
        if [[ "$fixture_rest" != */* ]]; then
          [[ "$fixture_rest" == *.rb ]] && {
            add_spec "$snapshot_gate_spec"
            add_spec "$flat_fixture_audit_spec"
          }
        elif [[ -f "spec/integration/fixtures/${fixture_rest%%/*}/demo.rb" ]]; then
          add_spec "$snapshot_gate_spec"
        fi
      fi
      if [[ "$path" == spec/fixtures/* || "$path" == spec/*/fixtures/* ]]; then
        fixture_dirs_matching "${path#*fixtures/}" && matched=1
      fi
      # The basename identifies the fixture, but only WITH its extension and
      # only while it is distinctive. A spec names a fixture as a file —
      # `fixtures/parity.rb`, or `hash_shape.rb:182` inside a describe string —
      # so the extension is part of the identifier, while the bare stem matches
      # the English word: the unbounded `demo` of the ~18-minute run #3171 was
      # filed for grepped out 113 specs, and `demo` still selects 98 under the
      # pattern below, against 66 for `demo.rb`. Four flat fixtures are named
      # only as `<basename>`, so dropping the extension loses them, and over
      # every flat fixture in the tree the basename selects at most 4 (one of
      # which is this gate's own spec, which carries the name). Take it
      # only while it selects few, which refuses the generic basenames
      # (`demo.rb` 66, `.rigor.yml` 111, `a.rb` 179); otherwise add nothing,
      # and the uncovered line below reports the path. A dotfile needs no
      # separate guard: it is over the cap like the rest.
      if [[ -z "$matched" ]]; then
        base_matches="$(spec_paths_matching "(^|[^A-Za-z0-9_])$(ere_literal "$base")([^A-Za-z0-9_]|$)")"
        if (( $(printf '%s' "$base_matches" | grep -c .) <= 10 )); then
          while IFS= read -r spec; do [[ -n "$spec" ]] && add_spec "$spec"; done <<< "$base_matches"
        fi
      fi
      [[ "$specs$pool_specs$plugin_specs" == "$before" ]] && uncovered+="$path (no spec names it)"$'\n'
      ;;
    lib/*.rb)
      mirror="spec/${path#lib/}"
      add_mirror_spec "${mirror%.rb}_spec.rb"
      add_mirror_dir_specs "${mirror%.rb}"
      check_files+="$path"$'\n'
      case "$path" in
        lib/rigor/analysis/incremental*.rb | lib/rigor/analysis/incremental*/*.rb | lib/rigor/analysis/dependency_recorder.rb)
          dependency_edit=1
          ;;
        *)
          if git ls-files --error-unmatch "$path" >/dev/null 2>&1; then
            # No -q: grep must drain the diff, or a large one dies of SIGPIPE
            # and pipefail drops the match.
            git diff "$merge_base" -- "$path" | grep -E "^[+-].*($dependency_recording_re)" >/dev/null && dependency_edit=1
          else
            grep -qE "$dependency_recording_re" "$path" && dependency_edit=1
          fi
          ;;
      esac
      ;;
    tool/*.rb)
      mirror="spec/${path}"
      add_mirror_spec "${mirror%.rb}_spec.rb"
      add_mirror_dir_specs "${mirror%.rb}"
      ;;
    sig/*.rbs)
      mirror="lib/${path#sig/}"
      mirror="${mirror%.rbs}.rb"
      [[ -f "$mirror" ]] && check_files+="$mirror"$'\n'
      ;;
    plugins/rigor-*/* | examples/rigor-*/*)
      gem="${path#*/}"
      gem="${gem%%/*}"
      id="${gem#rigor-}"
      id="${id//-/_}"
      case "$path" in
        plugins/*) dir=spec/integration/plugins ;;
        *) dir=spec/integration/examples ;;
      esac
      for spec in "$dir/${id}"_*spec.rb; do
        [[ -f "$spec" ]] && add_spec "$spec"
      done
      # Specs that load it by gem name (ffi_plugins_spec, the cross-plugin rows).
      add_specs_matching "${gem}([^a-z0-9_-]|\$)"
      if [[ -z "$quick" ]]; then
        add_spec spec/integration/all_plugins_load_spec.rb
        add_spec spec/integration/plugin_contract_conformance_spec.rb
      fi
      case "$path" in
        */lib/*.rb) check_files+="$path"$'\n' ;;
      esac
      ;;
  esac
done
for path in ${deleted[@]+"${deleted[@]}"}; do
  # A deleted sig/ file drops rows provenance_spec pins, so a deletion runs the drift specs too.
  case "$path" in
    lib/* | sig/* | data/* | .rigor.dist.yml)
      [[ -z "$quick" ]] && for spec in "${engine_drift_specs[@]}"; do add_spec "$spec"; done
      engine_changed=1
      ;;
    plugins/*/lib/*)
      for spec in "${declaration_fact_specs[@]}"; do add_spec "$spec"; done
      add_spec "$ancestry_walker_spec"
      ;;
  esac
  case "$path" in
    lib/rigor/analysis/incremental*.rb | lib/rigor/analysis/incremental*/*.rb | lib/rigor/analysis/dependency_recorder.rb)
      dependency_edit=1
      ;;
    lib/*.rb)
      git show "$merge_base:$path" 2>/dev/null | grep -E "$dependency_recording_re" >/dev/null && dependency_edit=1
      ;;
  esac
  case "$path" in
    *.md) ;;
    *) uncovered+="$path (deleted: its dependents are not checked locally)"$'\n' ;;
  esac
done

if [[ -n "$dependency_edit" && -z "$quick" ]]; then
  while IFS= read -r spec; do add_spec "$spec"; done < <(
    grep -lE "$precision_assertion_re" spec/rigor/analysis/*incremental*_spec.rb
  )
fi

# `run_on <step name> <list> <command...>`: append the list's entries to the
# command and run it as a step, or skip the step when the list is empty.
run_on() {
  local name="$1" list="$2"
  shift 2
  [[ -z "$list" ]] && return
  local files=()
  while IFS= read -r path; do files+=("$path"); done < <(lines "$list")
  step "$name" "$@" "${files[@]}"
}

# --list-specs: stdout is the selected spec paths only, one per line; the
# uncovered report goes to stderr. No check runs.
if [[ -n "$list_only" ]]; then
  lines "$specs$pool_specs$plugin_specs"
  if [[ -n "$uncovered" ]]; then
    echo "verify-changed: not covered locally:" >&2
    lines "$uncovered" | sed 's/^/  - /' >&2
  fi
  exit 0
fi

# `--only-recognized-file-types` drops a named file RuboCop would not pick up on
# its own (a .md, a .yml), while still taking config.ru, Gemfile and *.gemspec.
run_on "rubocop (changed files)" "$lint_files" \
  bundle exec rubocop --force-exclusion --only-recognized-file-types
run_on "rspec (affected specs)" "$specs" bundle exec rspec
run_on "rspec (runner pool)" "$pool_specs" env RIGOR_INCLUDE_RACTOR_POOL=1 bundle exec rspec
run_on "rspec (plugin integration)" "$plugin_specs" env RIGOR_INCLUDE_INTEGRATION_PLUGINS=1 bundle exec rspec
# The pinned examples, by line (tool/pin_examples.rb): the files whole take ~75s, the pins alone ~7s. A
# locator that fails or finds nothing fails the gate rather than skipping the step.
if [[ -n "$engine_changed" && -z "$quick" ]]; then
  if pins="$(bundle exec ruby tool/pin_examples.rb)" && [[ -n "$pins" ]]; then
    # Plugin integration pins run in their own process, as their files do above.
    run_on "rspec (pinned flip-this-when examples)" "$(printf '%s\n' "$pins" | grep -Ev '^spec/integration/(plugins|examples)/')" \
      bundle exec rspec
    run_on "rspec (pinned plugin examples)" "$(printf '%s\n' "$pins" | grep -E '^spec/integration/(plugins|examples)/')" \
      env RIGOR_INCLUDE_INTEGRATION_PLUGINS=1 bundle exec rspec
  else
    echo
    echo "== rspec (pinned flip-this-when examples)"
    echo "tool/pin_examples.rb failed or found no pins"
    failures+=("rspec (pinned flip-this-when examples)")
  fi
fi
if [[ -z "$quick" ]]; then
  step "rspec spec/docs/" bundle exec rspec spec/docs/
  run_on "rigor check (changed lib files)" "$check_files" \
    bundle exec exe/rigor check --no-cache --no-ci-detect --fail-on=warning
fi

echo
if [[ -n "$uncovered" ]]; then
  echo "verify-changed: not covered locally — the full CI run at gh pr ready decides these:"
  lines "$uncovered" | sed 's/^/  - /'
fi
if [[ -n "$quick" ]]; then
  echo "verify-changed --quick: SKIPPED, so this is NOT the pre-push gate:"
  echo "  - the whole-engine drift specs (public API, ractor readiness, provenance, declaration facts, ancestry walker, snapshot gate, type construction)"
  echo "  - the \"flip this when #N\" pinned examples"
  echo "  - the incremental \"not re-checked\" specs"
  echo "  - spec/docs/"
  echo "  - the rigor check self-check"
  echo "  - the all-plugin conformance specs for a plugin or example change"
  echo "verify-changed --quick: run \`make verify-changed\` before pushing."
fi
if ((${#failures[@]})); then
  echo "verify-changed: FAILED — ${failures[*]}"
  exit 1
fi
if [[ -n "$quick" ]]; then
  echo "verify-changed --quick: the checks it ran passed. Not the pre-push gate."
  exit 0
fi
echo "verify-changed: OK. The full gate is the PR's full CI run, at gh pr ready."
