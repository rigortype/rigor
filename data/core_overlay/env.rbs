# Rigor core overlay — supplemental core signatures.
#
# --- ENV.fetch_values (Ruby 4.1) ---
#
# Issue #1691. Ruby 4.1 adds `ENV.fetch_values` (`hash.c`, call-seq
# `ENV.fetch_values(*names) -> array of values` and
# `ENV.fetch_values(*names) {|name| ... } -> array of values`), mirroring
# `Hash#fetch_values`. No rbs release through 4.2 declares it on
# `RBS::Unnamed::ENVClass`, the class rbs gives the `ENV` object, so correct
# 4.1 code reported `call.undefined-method`. The name and value types follow
# that class's own `fetch`.
#
# TEMPORARY: delete this file once the rbs release Rigor bundles declares
# the method upstream.
#
# Declared unconditionally, not gated on `target_ruby` (ADR-121 § Rejected
# alternatives; false positives outrank), and on a module the class
# includes so that a later direct declaration overrides it instead of
# raising `DuplicatedMethodDefinitionError` for the whole class (see
# `process.rbs`).
module RigorCoreOverlay
  module Ruby41EnvFetchValues
    def fetch_values: (*String names) -> Array[String]
                    | [X] (*String names) { (String name) -> X } -> Array[String | X]
  end
end

module RBS
  module Unnamed
    class ENVClass
      include RigorCoreOverlay::Ruby41EnvFetchValues
    end
  end
end
