module Rigor
  module Plugin
    # One `effect_ancestry:` row: an ancestry edge the plugin's own gem introduces and the project's
    # source never writes down (ADR-103 WD17, #465). `parent:` need only be a true ancestor, not the
    # immediate superclass. Bundled plugins only — `Effects::PluginFacts` enforces it. Frozen value
    # object.
    class EffectAncestry
      # sig-gen gap: #2312 — `child:` is `untyped` (input `untyped`, looks deliberate; a declared type is authoring
      # intent tracked by #2325, and only then does this row generate; coercion-facing: `to_s`, then a class-name
      # check), and `initialize` stores the private `validate_class_name!` helper's result (#2312).
      attr_reader child: String
      # sig-gen gap: #2312 — same shape as `child`.
      attr_reader parent: String
      # sig-gen gap: #2312 — same shape; `why:` is `untyped` and the private `validate_why!` helper (#2312) requires
      # it non-empty.
      attr_reader why: String

      def initialize: (child: untyped, parent: untyped, why: untyped) -> void

      def to_h: () -> Hash[String, untyped]

      def ==: (untyped other) -> bool
      # `alias eql? ==` — the alias row has no sig-gen shape, so it stays unmarked
      # residue.
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
  end
end
